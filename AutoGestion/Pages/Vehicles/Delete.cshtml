@page
@model AutoGestion.Pages.VehiclePages.DeleteModel

@{
    ViewData["Title"] = $"Eliminar Vehículo - {Model.Vehicle.LicensePlate}";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-page="./Index" class="text-decoration-none">Gestión de Vehículos</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Eliminar Vehículo</li>
                </ol>
            </nav>
            <h1 class="h3 text-dark fw-bold m-0">Eliminar Vehículo</h1>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary d-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i>
            <span>Volver a la Lista</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Mensaje de Advertencia -->
            <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3 mb-4 rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-2 text-warning flex-shrink-0"></i>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">¿Estás seguro de que deseas eliminar este vehículo?</h5>
                    <p class="mb-0 text-secondary">Esta acción removerá la unidad del sistema. Verifica que no existan órdenes de trabajo o recepciones activas asociadas a esta placa.</p>
                </div>
            </div>

            <!-- Resumen del Vehículo -->
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title fw-bold text-dark mb-0">
                        <i class="bi bi-car-front-fill text-danger me-2"></i>Placa: @Model.Vehicle.LicensePlate
                    </h5>
                    <span class="badge bg-light text-dark border px-3 py-2">
                        @(Model.Vehicle.Year > 0 ? Model.Vehicle.Year.ToString() : "Año N/A")
                    </span>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4 mb-3">
                        <!-- Marca y Modelo -->
                        <div class="col-md-6">
                            <span class="text-muted small d-block mb-1">
                                <i class="bi bi-info-circle text-primary me-1"></i> Marca / Modelo
                            </span>
                            <span class="fw-bold text-dark fs-6">
                                @Model.Vehicle.Brand @Model.Vehicle.Model
                            </span>
                        </div>

                        <!-- Propietario / Cliente -->
                        <div class="col-md-6">
                            <span class="text-muted small d-block mb-1">
                                <i class="bi bi-person text-primary me-1"></i> Propietario Asignado
                            </span>
                            <span class="fw-bold text-dark fs-6">
                                @(Model.Vehicle.Client != null ? $"{Model.Vehicle.Client.FirstName} {Model.Vehicle.Client.LastName}" : "Sin asignar")
                            </span>
                        </div>

                        <!-- Transmisión -->
                        <div class="col-md-6">
                            <span class="text-muted small d-block mb-1">
                                <i class="bi bi-gear-wide-connected text-secondary me-1"></i> Transmisión
                            </span>
                            <span class="badge bg-secondary bg-opacity-10 text-dark border border-secondary border-opacity-25 px-2 py-1">
                                @Model.Vehicle.Transmission
                            </span>
                        </div>

                        <!-- Teléfono Propietario -->
                        <div class="col-md-6">
                            <span class="text-muted small d-block mb-1">
                                <i class="bi bi-telephone text-secondary me-1"></i> Contacto Propietario
                            </span>
                            <span class="text-dark fs-6">
                                @(Model.Vehicle.Client?.PrimaryPhone ?? "N/A")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Footer con Formulario POST de Eliminación -->
                <div class="card-footer bg-light p-3 border-top d-flex justify-content-end gap-2">
                    <form method="post" class="m-0">
                        <input type="hidden" asp-for="Vehicle.Id" />
                        <a asp-page="./Index" class="btn btn-outline-secondary px-4 me-2">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4 d-inline-flex align-items-center gap-2">
                            <i class="bi bi-trash-fill"></i>
                            <span>Confirmar Eliminación</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
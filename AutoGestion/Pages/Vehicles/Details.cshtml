@page
@model AutoGestion.Pages.VehiclePages.DetailsModel

@{
    ViewData["Title"] = "Detalles del Vehículo";
}

<!-- Encabezado de la Página -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-car-front-fill text-primary me-2"></i>Detalles del Vehículo
        </h2>
        <p class="text-muted small mb-0">Ficha técnica del vehículo y órdenes de ingreso asociadas.</p>
    </div>
    <div>
        <a asp-page="./Edit" asp-route-id="@Model.Vehicle.Id" class="btn btn-warning fw-semibold me-2 shadow-sm">
            <i class="bi bi-pencil-square me-1"></i> Editar
        </a>
        <a asp-page="./Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Ficha Técnica del Vehículo -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-info-circle text-primary me-2"></i>Especificaciones
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Placa</label>
                        <span class="badge bg-light text-dark border fs-6 mt-1">
                            @Html.DisplayFor(model => model.Vehicle.LicensePlate)
                        </span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Año</label>
                        <span class="fw-bold text-dark fs-6">
                            @(Model.Vehicle.Year > 0 ? Model.Vehicle.Year.ToString() : "N/A")
                        </span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Marca</label>
                        <span class="fw-semibold text-dark">@Html.DisplayFor(model => model.Vehicle.Brand)</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Modelo</label>
                        <span class="fw-semibold text-dark">@Html.DisplayFor(model => model.Vehicle.Model)</span>
                    </div>

                    <div class="col-12">
                        <label class="text-muted small d-block">Transmisión</label>
                        <span class="badge bg-secondary bg-opacity-10 text-dark border border-secondary border-opacity-25 px-2 py-1 fw-normal">
                            @Html.DisplayFor(model => model.Vehicle.Transmission)
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Propietario e Historial de Órdenes -->
    <div class="col-lg-5 d-flex flex-column gap-4">
        <!-- Propietario -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-person-fill text-primary me-2"></i>Propietario
                </h5>
            </div>
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold mb-1 text-dark">
                        @(Model.Vehicle.Client?.FullName ?? "Sin propietario asignado")
                    </h6>
                    <small class="text-muted">Cédula: @(Model.Vehicle.Client?.Identification ?? "N/A")</small>
                </div>
                @if (Model.Vehicle.Client != null)
                {
                    <a asp-page="/Clients/Details" asp-route-id="@Model.Vehicle.ClientId" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye"></i> Ver Cliente
                    </a>
                }
            </div>
        </div>

        <!-- Órdenes de Recepción Asociadas -->
        <div class="card border-0 shadow-sm rounded-3 flex-grow-1">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-clipboard-check text-warning me-2"></i>Historial de Ingresos
                </h5>
                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 rounded-pill">
                    @(Model.Vehicle.ReceivingOrders?.Count ?? 0)
                </span>
            </div>
            <div class="card-body p-0">
                @if (Model.Vehicle.ReceivingOrders != null && Model.Vehicle.ReceivingOrders.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var order in Model.Vehicle.ReceivingOrders)
                        {
                            <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">Orden #@order.Id</h6>
                                    <small class="text-muted">Fecha: @order.EntryDate.ToShortDateString()</small>
                                </div>
                                <a asp-page="/ReceivingOrders/Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-warning text-dark">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-clipboard-x fs-2 d-block mb-2 text-secondary opacity-50"></i>
                        No hay órdenes de recepción registradas para este vehículo.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
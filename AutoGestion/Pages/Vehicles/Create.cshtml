@page
@model AutoGestion.Pages.VehiclePages.CreateModel

@{
    ViewData["Title"] = "Registrar Vehículo";
}

<!-- Encabezado de la Página -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-car-front-fill text-primary me-2"></i>Registrar Vehículo
        </h2>
        <p class="text-muted small mb-0">Ingresa los datos de la unidad y asóciala a un cliente.</p>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-info-circle text-primary me-2"></i>Información del Vehículo
                </h5>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>

                    <div class="row g-3">
                        <!-- Selección de Cliente -->
                        <div class="col-12">
                            <label asp-for="Vehicle.ClientId" class="form-label fw-semibold text-dark">Propietario / Cliente <span class="text-danger">*</span></label>
                            <select asp-for="Vehicle.ClientId" class="form-select" asp-items="ViewBag.ClientId">
                                <option value="">-- Selecciona un cliente --</option>
                            </select>
                            <span asp-validation-for="Vehicle.ClientId" class="text-danger small"></span>
                        </div>

                        <!-- Placa -->
                        <div class="col-md-6">
                            <label asp-for="Vehicle.LicensePlate" class="form-label fw-semibold text-dark">Placa <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-card-heading"></i></span>
                                <input asp-for="Vehicle.LicensePlate" class="form-control" placeholder="Ej: ABC-123" />
                            </div>
                            <span asp-validation-for="Vehicle.LicensePlate" class="text-danger small"></span>
                        </div>

                        <!-- Año -->
                        <div class="col-md-6">
                            <label asp-for="Vehicle.Year" class="form-label fw-semibold text-dark">Año</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="Vehicle.Year" class="form-control" placeholder="Ej: 2020" />
                            </div>
                            <span asp-validation-for="Vehicle.Year" class="text-danger small"></span>
                        </div>

                        <!-- Marca -->
                        <div class="col-md-6">
                            <label asp-for="Vehicle.Brand" class="form-label fw-semibold text-dark">Marca <span class="text-danger">*</span></label>
                            <input asp-for="Vehicle.Brand" class="form-control" placeholder="Ej: Toyota" />
                            <span asp-validation-for="Vehicle.Brand" class="text-danger small"></span>
                        </div>

                        <!-- Modelo -->
                        <div class="col-md-6">
                            <label asp-for="Vehicle.Model" class="form-label fw-semibold text-dark">Modelo <span class="text-danger">*</span></label>
                            <input asp-for="Vehicle.Model" class="form-control" placeholder="Ej: Corolla" />
                            <span asp-validation-for="Vehicle.Model" class="text-danger small"></span>
                        </div>

                        <!-- Transmisión -->
                        <div class="col-12">
                            <label asp-for="Vehicle.Transmission" class="form-label fw-semibold text-dark">Transmisión</label>
                            <select asp-for="Vehicle.Transmission" class="form-select"
                                    asp-items="Html.GetEnumSelectList<AutoGestion.Utilities.Commons.AppConstants.Transmission>()">
                                <option value="">-- Selecciona el tipo de transmisión --</option>
                            </select>
                            <span asp-validation-for="Vehicle.Transmission" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Botones de Acción -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="./Index" class="btn btn-light border fw-semibold">Cancelar</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Guardar Vehículo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
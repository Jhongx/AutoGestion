@page
@model AutoGestion.Pages.ClientPages.IndexModel

@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="container-fluid px-2 px-md-4 py-3">
    <!-- Encabezado de la Sección con Botón de Volver y Registrar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Inicio</a></li>
                    <li class="breadcrumb-item active">Clientes</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1 h3">
                <i class="bi bi-people-fill text-primary me-2"></i>Clientes
            </h2>
            <p class="text-muted small mb-0">Listado general de propietarios y datos de contacto registrados.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Botón de Volver adaptable -->
            <a asp-page="/Index" class="btn btn-outline-secondary fw-semibold shadow-sm flex-fill flex-sm-grow-0">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
            <!-- Botón de Registrar -->
            <a asp-page="Create" class="btn btn-primary fw-semibold shadow-sm flex-fill flex-sm-grow-0">
                <i class="bi bi-person-plus-fill me-1"></i> Registrar
            </a>
        </div>
    </div>

    @if (!Model.Client.Any())
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                <p class="mb-0 fw-semibold">No hay clientes registrados en el sistema.</p>
                <small class="text-muted">Utiliza el botón de registrar para agregar el primero.</small>
            </div>
        </div>
    }
    else
    {
        <!-- ========================================== -->
        <!-- 1. VISTA DE TABLA (Visible solo en Desktop / d-md-block) -->
        <!-- ========================================== -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden d-none d-md-block">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="ps-4 py-3"><i class="bi bi-person me-1"></i> Nombre Completo</th>
                                <th class="py-3"><i class="bi bi-card-heading me-1"></i> Identificación</th>
                                <th class="py-3"><i class="bi bi-telephone me-1"></i> Teléfono Principal</th>
                                <th class="py-3"><i class="bi bi-telephone-plus me-1"></i> Teléfono Secundario</th>
                                <th class="py-3"><i class="bi bi-envelope me-1"></i> Correo Electrónico</th>
                                <th class="text-center py-3"><i class="bi bi-car-front me-1"></i> Vehículos</th>
                                <th class="text-end pe-4 py-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Client)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">@Html.DisplayFor(model => item.FullName)</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@Html.DisplayFor(model => item.Identification)</span>
                                    </td>
                                    <td>
                                        <a href="tel:@item.PrimaryPhone" class="text-decoration-none text-dark">
                                            @Html.DisplayFor(model => item.PrimaryPhone)
                                        </a>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.SecondaryPhone))
                                        {
                                            <a href="tel:@item.SecondaryPhone" class="text-decoration-none text-muted">
                                                @Html.DisplayFor(model => item.SecondaryPhone)
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted opacity-50 fs-7">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Email))
                                        {
                                            <a href="mailto:@item.Email" class="text-decoration-none text-primary">
                                                @Html.DisplayFor(model => item.Email)
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted opacity-50 fs-7">N/A</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1 rounded-pill fw-semibold">
                                            @(item.Vehicles?.Count ?? 0) reg.
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 2. VISTA DE TARJETAS (Visible solo en Móvil / d-block d-md-none) -->
        <!-- ========================================== -->
        <div class="d-block d-md-none d-flex flex-column gap-3">
            @foreach (var item in Model.Client)
            {
                <div class="card border-0 shadow-sm rounded-3 p-3">
                    <!-- Cabecera de la tarjeta: Nombre y Badge de Identificación -->
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="fw-bold text-dark mb-1">@item.FullName</h6>
                            <span class="badge bg-light text-dark border small">
                                <i class="bi bi-card-heading me-1 text-muted"></i>@item.Identification
                            </span>
                        </div>
                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1 rounded-pill fw-semibold">
                            <i class="bi bi-car-front"></i> @(item.Vehicles?.Count ?? 0) veh.
                        </span>
                    </div>

                    <!-- Datos de Contacto (Teléfonos y Correo) -->
                    <div class="small text-muted py-2 border-top border-bottom my-2 d-flex flex-column gap-1">
                        <div>
                            <i class="bi bi-telephone text-primary me-1"></i> <strong>Principal:</strong>
                            @if (!string.IsNullOrEmpty(item.PrimaryPhone))
                            {
                                <a href="tel:@item.PrimaryPhone" class="text-decoration-none text-dark">@item.PrimaryPhone</a>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </div>
                        <div>
                            <i class="bi bi-telephone-plus text-muted me-1"></i> <strong>Secundario:</strong>
                            @if (!string.IsNullOrEmpty(item.SecondaryPhone))
                            {
                                <a href="tel:@item.SecondaryPhone" class="text-decoration-none text-muted">@item.SecondaryPhone</a>
                            }
                            else
                            {
                                <span class="opacity-50">N/A</span>
                            }
                        </div>
                        <div>
                            <i class="bi bi-envelope text-primary me-1"></i> <strong>Correo:</strong>
                            @if (!string.IsNullOrEmpty(item.Email))
                            {
                                <a href="mailto:@item.Email" class="text-decoration-none text-primary text-break">@item.Email</a>
                            }
                            else
                            {
                                <span class="opacity-50">N/A</span>
                            }
                        </div>
                    </div>

                    <!-- Botones de Acción Móvil (Grandes, cómodos para tocar con el dedo) -->
                    <div class="d-flex gap-2 mt-1">
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-eye"></i> Detalles
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
@page
@model AutoGestion.Pages.ClientPages.DetailsModel

@{
    ViewData["Title"] = "Detalles del Cliente";
}

<!-- Encabezado de la Página -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-person-vcard text-primary me-2"></i>Detalles del Cliente
        </h2>
        <p class="text-muted small mb-0">Información de contacto y relación de vehículos asociados.</p>
    </div>
    <div>
        <a asp-page="./Edit" asp-route-id="@Model.Client.Id" class="btn btn-warning fw-semibold me-2 shadow-sm">
            <i class="bi bi-pencil-square me-1"></i> Editar
        </a>
        <a asp-page="./Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Informacion del Cliente -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-person-fill text-primary me-2"></i>Información General
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Nombre</label>
                        <span class="fs-6 fw-bold text-dark">@Html.DisplayFor(model => model.Client.FirstName)</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Apellidos</label>
                        <span class="fs-6 fw-bold text-dark">@Html.DisplayFor(model => model.Client.LastName)</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Cédula / Identificación</label>
                        <span class="badge bg-light text-dark border fs-6 mt-1">
                            @Html.DisplayFor(model => model.Client.Identification)
                        </span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Teléfono Principal</label>
                        <a href="tel:@Model.Client.PrimaryPhone" class="text-decoration-none fw-semibold text-dark">
                            <i class="bi bi-telephone text-success me-1"></i>@Html.DisplayFor(model => model.Client.PrimaryPhone)
                        </a>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Teléfono Secundario</label>
                        @if (!string.IsNullOrEmpty(Model.Client.SecondaryPhone))
                        {
                            <a href="tel:@Model.Client.SecondaryPhone" class="text-decoration-none text-muted">
                                <i class="bi bi-telephone text-secondary me-1"></i>@Html.DisplayFor(model => model.Client.SecondaryPhone)
                            </a>
                        }
                        else
                        {
                            <span class="text-muted opacity-50">N/A</span>
                        }
                    </div>

                    <div class="col-12">
                        <label class="text-muted small d-block">Correo Electrónico</label>
                        @if (!string.IsNullOrEmpty(Model.Client.Email))
                        {
                            <a href="mailto:@Model.Client.Email" class="text-decoration-none text-primary fw-semibold">
                                <i class="bi bi-envelope me-1"></i>@Html.DisplayFor(model => model.Client.Email)
                            </a>
                        }
                        else
                        {
                            <span class="text-muted opacity-50">N/A</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Vehículos del Cliente -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-car-front-fill text-info me-2"></i>Vehículos Registrados
                </h5>
                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill">
                    @(Model.Client.Vehicles?.Count ?? 0)
                </span>
            </div>
            <div class="card-body p-0">
                @if (Model.Client.Vehicles != null && Model.Client.Vehicles.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var vehicle in Model.Client.Vehicles)
                        {
                            <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">@vehicle.Brand @vehicle.Model</h6>
                                    <small class="text-muted">Placa: <strong class="text-dark">@vehicle.LicensePlate</strong> | Año: @vehicle.Year</small>
                                </div>
                                <a asp-page="/Vehicles/Details" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-car-front fs-2 d-block mb-2 text-secondary opacity-50"></i>
                        Este cliente no tiene vehículos asociados actualmente.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
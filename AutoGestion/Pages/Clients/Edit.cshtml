@page
@model AutoGestion.Pages.ClientPages.EditModel

@{
    ViewData["Title"] = "Editar Cliente";
}
<!-- Encabezado de la Página -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-pencil-square text-warning me-2"></i>Editar Cliente
        </h2>
        <p class="text-muted small mb-0">Actualiza los datos personales o de contacto del cliente seleccionado.</p>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-person-vcard text-warning me-2"></i>Información Personal
                </h5>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>
                    <input type="hidden" asp-for="Client.Id" />

                    <div class="row g-3">
                        <!-- Nombre -->
                        <div class="col-md-6">
                            <label asp-for="Client.FirstName" class="form-label fw-semibold text-dark">Nombre <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input asp-for="Client.FirstName" class="form-control" placeholder="Ej: Juan" />
                            </div>
                            <span asp-validation-for="Client.FirstName" class="text-danger small"></span>
                        </div>

                        <!-- Apellidos -->
                        <div class="col-md-6">
                            <label asp-for="Client.LastName" class="form-label fw-semibold text-dark">Apellidos <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input asp-for="Client.LastName" class="form-control" placeholder="Ej: Pérez" />
                            </div>
                            <span asp-validation-for="Client.LastName" class="text-danger small"></span>
                        </div>

                        <!-- Tipo de Documento (Ahora Opcional) -->
                        <div class="col-md-6">
                            <label asp-for="Client.DocTypeId" class="form-label fw-semibold text-dark">Tipo de Documento</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-card-checklist"></i></span>
                                <select asp-for="Client.DocTypeId" class="form-select" asp-items="ViewBag.DocTypeId">
                                    <option value="">-- Seleccione un tipo --</option>
                                </select>
                            </div>
                            <span asp-validation-for="Client.DocTypeId" class="text-danger small"></span>
                        </div>

                        <!-- Cédula / Identificación (Ahora Opcional) -->
                        <div class="col-md-6">
                            <label asp-for="Client.Identification" class="form-label fw-semibold text-dark">Identificación</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-card-heading"></i></span>
                                <input asp-for="Client.Identification" class="form-control" placeholder="Ej: 102340567" />
                            </div>
                            <span asp-validation-for="Client.Identification" class="text-danger small"></span>
                        </div>

                        <!-- Correo Electrónico -->
                        <div class="col-md-6">
                            <label asp-for="Client.Email" class="form-label fw-semibold text-dark">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Client.Email" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                            </div>
                            <span asp-validation-for="Client.Email" class="text-danger small"></span>
                        </div>

                        <!-- Teléfono Principal -->
                        <div class="col-md-6">
                            <label asp-for="Client.PrimaryPhone" class="form-label fw-semibold text-dark">Teléfono Principal <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Client.PrimaryPhone" class="form-control" placeholder="Ej: 8888-8888" />
                            </div>
                            <span asp-validation-for="Client.PrimaryPhone" class="text-danger small"></span>
                        </div>

                        <!-- Teléfono Secundario -->
                        <div class="col-md-6">
                            <label asp-for="Client.SecondaryPhone" class="form-label fw-semibold text-dark">Teléfono Secundario</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone-plus"></i></span>
                                <input asp-for="Client.SecondaryPhone" class="form-control" placeholder="Ej: 2222-2222" />
                            </div>
                            <span asp-validation-for="Client.SecondaryPhone" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Botones de Acción -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="./Index" class="btn btn-light border fw-semibold">Cancelar</a>
                        <button type="submit" class="btn btn-warning fw-semibold px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
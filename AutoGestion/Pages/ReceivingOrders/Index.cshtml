@page
@model AutoGestion.Pages.ReceivingOrderPages.IndexModel

@{
    ViewData["Title"] = "Recepción de Vehículos";
}
@using AutoGestion.Utilities.Commons

<div class="container-fluid px-2 px-md-4 py-3">
    <!-- Encabezado de la Sección con Breadcrumb y Botones de Volver y Registrar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Inicio</a></li>
                    <li class="breadcrumb-item active">Recepción de Vehículos</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1 h3">
                <i class="bi bi-journal-text text-primary me-2"></i>Recepción de Vehículos
            </h2>
            <p class="text-muted small mb-0">Gestión de órdenes de entrada y diagnóstico de taller.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-page="./Calendar" class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 px-3 py-2 shadow-sm fw-semibold flex-fill flex-sm-grow-0">
                <i class="bi bi-calendar-event"></i>
                <span>Ver Calendario</span>
            </a>
            <a asp-page="Create" class="btn btn-primary d-flex align-items-center justify-content-center gap-2 px-3 py-2 shadow-sm fw-semibold flex-fill flex-sm-grow-0">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Nueva Orden</span>
            </a>
        </div>
    </div>

    <!-- TARJETAS KPI / RESUMEN -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 d-block d-md-none bg-light">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small text-uppercase fw-bold"><i class="bi bi-speedometer2 me-1"></i> Resumen de Órdenes</span>
                <span class="badge bg-primary text-white fw-semibold">Total: @Model.ReceivingOrder.Count</span>
            </div>
            <div class="row text-center g-2 pt-1 border-top">
                <div class="col-6 border-end">
                    <div class="text-success small fw-bold"><i class="bi bi-calendar-check"></i> Ingresos Hoy</div>
                    <span class="fw-bold text-dark fs-5">@Model.ReceivingOrder.Count(x => x.DateTime.Date == DateTime.Today)</span>
                </div>
                <div class="col-6">
                    <div class="text-warning small fw-bold"><i class="bi bi-tools"></i> Tipos de Servicio</div>
                    <span class="fw-bold text-dark fs-5">@Model.ReceivingOrder.Select(x => x.ServiceType).Distinct().Count()</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4 d-none d-md-flex">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-primary border-4 rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Órdenes Totales</span>
                            <h3 class="fw-bold mb-0 mt-1">@Model.ReceivingOrder.Count</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                            <i class="bi bi-journal-text fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-success border-4 rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Ingresos Hoy</span>
                            <h3 class="fw-bold mb-0 mt-1">@Model.ReceivingOrder.Count(x => x.DateTime.Date == DateTime.Today)</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                            <i class="bi bi-calendar-check fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-warning border-4 rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Tipos de Servicio</span>
                            <h3 class="fw-bold mb-0 mt-1">@Model.ReceivingOrder.Select(x => x.ServiceType).Distinct().Count()</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                            <i class="bi bi-tools fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenedor General de Búsqueda y Registros -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom border-light">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <h5 class="card-title text-dark fw-bold mb-0">Órdenes Registradas</h5>
                </div>
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control bg-light border-start-0 ps-0" placeholder="Buscar por orden, placa, vehículo, estado...">
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.ReceivingOrder.Any())
        {
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                <span class="fw-medium">No hay órdenes de recepción registradas.</span>
            </div>
        }
        else
        {
            <!-- ========================================== -->
            <!-- 1. VISTA DE TABLA (Desktop) -->
            <!-- ========================================== -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary text-uppercase small border-bottom">
                        <tr>
                            <th class="ps-4 py-3" style="width: 130px;">N° / Fecha</th>
                            <th class="py-3" style="width: 190px;">Vehículo</th>
                            <th class="py-3" style="width: 150px;">Tipo de Servicio</th>
                            <th class="py-3" style="width: 180px;">Estado</th> <!-- Margen ampliado para mejor visibilidad -->
                            <th class="py-3">Motivo / Problema</th>
                            <th class="text-end pe-4 py-3" style="width: 140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ReceivingOrder)
                        {
                            var statusInfo = AutoGestion.Utilities.Commons.AppConstants.ReceivingOrderStatusDisplayNames.GetInfo(item.Status);
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="fw-bold text-dark">#@item.Id.ToString("D5")</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-calendar3 me-1"></i>@item.DateTime.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td class="py-3">
                                    @if (item.Vehicle != null)
                                    {
                                        <div class="fw-bold text-dark mb-1">@item.Vehicle.Brand @item.Vehicle.Model</div>
                                        <span class="badge bg-light text-dark border font-monospace small">
                                            <i class="bi bi-card-heading me-1 text-secondary"></i>@item.Vehicle.LicensePlate
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Vehículo #@item.VehicleId</span>
                                    }
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-2 px-2 py-1 fw-semibold">
                                        @item.ServiceType
                                    </span>
                                </td>
                                <!-- CELDAS DE ESTADO MEJORADAS -->
                                <td class="py-3">
                                    <span class="badge @statusInfo.BadgeClass bg-opacity-10 text-dark border border-opacity-25 rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm">
                                        <i class="bi bi-circle-fill small text-success @statusInfo.BadgeClass.Replace("bg-", "text-")"></i>
                                        <span>@statusInfo.Name</span>
                                    </span>
                                </td>
                                <td class="py-3">
                                    <div class="text-truncate text-secondary" style="max-width: 260px;" title="@item.ProblemDescription">
                                        @(string.IsNullOrWhiteSpace(item.ProblemDescription) ? "Sin observaciones" : item.ProblemDescription)
                                    </div>
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-light border text-body" title="Ver Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-light border text-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-light border text-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- ========================================== -->
            <!-- 2. VISTA DE TARJETAS (Móvil) -->
            <!-- ========================================== -->
            <div class="d-block d-md-none p-3 d-flex flex-column gap-3">
                @foreach (var item in Model.ReceivingOrder)
                {
                    var statusInfo = AutoGestion.Utilities.Commons.AppConstants.ReceivingOrderStatusDisplayNames.GetInfo(item.Status);
                    <div class="card border shadow-none rounded-3 p-3 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark">#@item.Id.ToString("D5")</span>
                            <!-- BADGE DE ESTADO EN MÓVIL MEJORADO -->
                            <span class="badge @statusInfo.BadgeClass bg-opacity-10 text-dark border border-opacity-25 rounded-pill px-3 py-1 small fw-semibold d-inline-flex align-items-center gap-1">
                                <i class="bi bi-circle-fill small @statusInfo.BadgeClass.Replace("bg-", "text-")"></i>
                                <span>@statusInfo.Name</span>
                            </span>
                        </div>

                        <div class="mb-2">
                            @if (item.Vehicle != null)
                            {
                                <div class="fw-bold text-dark">@item.Vehicle.Brand @item.Vehicle.Model</div>
                                <span class="badge bg-light text-dark border font-monospace small mt-1">
                                    <i class="bi bi-card-heading me-1 text-secondary"></i>@item.Vehicle.LicensePlate
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">Vehículo #@item.VehicleId</span>
                            }
                        </div>

                        <div class="small text-muted py-2 border-top border-bottom my-2 d-flex flex-column gap-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <span><strong>Servicio:</strong></span>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle fw-semibold">
                                    @item.ServiceType
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span><strong>Fecha:</strong></span>
                                <span>@item.DateTime.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="mt-1">
                                <strong>Problema:</strong>
                                <div class="text-secondary mt-0.5">
                                    @(string.IsNullOrWhiteSpace(item.ProblemDescription) ? "Sin observaciones" : item.ProblemDescription)
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-1">
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-eye"></i> Detalles
                            </a>
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchInput')?.addEventListener('keyup', function () {
            let filter = this.value.toLowerCase();
            let items = document.querySelectorAll('tbody tr, .d-block.d-md-none .card.border.shadow-none');

            items.forEach(item => {
                let text = item.innerText.toLowerCase();
                item.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
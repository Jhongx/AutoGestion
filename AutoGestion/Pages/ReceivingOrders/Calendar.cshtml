@page
@model AutoGestion.Pages.ReceivingOrders.CalendarModel
@{
    ViewData["Title"] = "Calendario de Recepciones";
}

<!-- FullCalendar JS -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

<div class="container-fluid px-2 px-md-4 py-3">
    <!-- Header principal -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="./Index" class="text-decoration-none">Recepción de Vehículos</a></li>
                    <li class="breadcrumb-item active">Calendario</li>
                </ol>
            </nav>
            <h1 class="h3 text-dark fw-bold m-0">
                <i class="bi bi-calendar3 text-primary me-2"></i>Calendario de Recepciones
            </h1>
        </div>
        <div>
            <a asp-page="./Index" class="btn btn-outline-secondary fw-semibold shadow-sm w-100 w-sm-auto">
                <i class="bi bi-list-ul me-1"></i> Ver Vista de Tabla
            </a>
        </div>
    </div>

    <!-- Leyenda de Colores Responsiva -->
    <div class="d-flex gap-2 gap-md-3 mb-3 flex-wrap align-items-center bg-white p-3 rounded-3 border shadow-sm">
        <span class="fw-bold small text-muted text-uppercase w-100 w-sm-auto mb-1 mb-sm-0">Leyenda:</span>
        <span class="badge bg-primary px-2 px-md-3 py-2 fs-7"><i class="bi bi-circle-fill me-1 small"></i> Mantenimiento</span>
        <span class="badge bg-danger px-2 px-md-3 py-2 fs-7"><i class="bi bi-circle-fill me-1 small"></i> Reparación</span>
        <span class="badge bg-warning text-dark px-2 px-md-3 py-2 fs-7"><i class="bi bi-circle-fill me-1 small"></i> Diagnóstico</span>
        <span class="badge bg-success px-2 px-md-3 py-2 fs-7"><i class="bi bi-circle-fill me-1 small"></i> Otros Servicios</span>
    </div>

    <!-- Layout principal -->
    <div class="row g-3 g-md-4">
        <!-- Contenedor del Calendario -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-2 p-md-4">
                    <!-- Inyección de Json mediante Dataset -->
                    <div id="calendar" data-events='@Html.Raw(Model.EventsJson)'></div>
                </div>
            </div>
        </div>

        <!-- Panel Lateral Derecha -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold text-dark m-0" id="selectedDateTitle">
                        <i class="bi bi-calendar-event text-primary me-2"></i>Recepciones
                    </h5>
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold" id="selectedDateBadge">
                        Hoy
                    </span>
                </div>
                <div class="card-body p-3 overflow-auto" style="max-height: 620px;">
                    <div id="sidePanelOrdersList" class="d-flex flex-column gap-3">
                        <!-- Carga dinámica desde JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ReceivingOrders/CalendarReceptions.js" asp-append-version="true"></script>
}

<style>
    /* Estilo para remarcar la celda del día seleccionado */
    .fc-day-selected {
        background-color: #e7f1ff !important;
        box-shadow: inset 0 0 0 2px #0d6efd !important;
        transition: background-color 0.2s ease, box-shadow 0.2s ease;
    }

    .fc-daygrid-day-events {
        margin-bottom: 0 !important;
    }

    .fc-daygrid-event-harness {
        max-width: 100% !important;
        overflow: hidden !important;
    }

    .fc-event {
        background-color: transparent !important;
        border: none !important;
        padding: 1px 2px !important;
        margin: 1px 0 !important;
    }

    .fc-custom-event {
        display: flex;
        align-items: center;
        gap: 4px;
        width: 100%;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        padding: 2px 4px;
        border-radius: 4px;
        background-color: rgba(255, 255, 255, 0.7);
        font-size: 0.75rem;
        color: #212529;
        font-weight: 600;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

        .fc-custom-event:hover {
            background-color: rgba(13, 110, 253, 0.15);
        }

    .fc-event-dot-custom {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .fc-event-title-custom {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .fc-more-link {
        font-size: 0.72rem;
        font-weight: bold;
        color: #0d6efd;
        padding-left: 4px;
    }

    .fc-daygrid-day {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

        .fc-daygrid-day:hover:not(.fc-day-selected) {
            background-color: rgba(13, 110, 253, 0.05) !important;
        }

    /* Ajustes específicos para móviles */
    @@media (max-width: 767.98px) {
        .fc-toolbar {
            flex-direction: column;
            gap: 8px;
        }

        .fc-toolbar-title {
            font-size: 1.1rem !important;
        }

        .fc-header-toolbar {
            margin-bottom: 0.5rem !important;
        }
    }
</style>
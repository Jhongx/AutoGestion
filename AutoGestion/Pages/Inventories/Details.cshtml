@page "{id:int}"
@model AutoGestion.Pages.InventoryPages.DetailsModel

@{
    ViewData["Title"] = "Detalles del Repuesto";
}

<!-- Encabezado de la Página -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-box-seam text-primary me-2"></i>Detalles del Repuesto / Insumo
        </h2>
        <p class="text-muted small mb-0">Información completa y estado de stock del producto.</p>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-info-circle text-primary me-2"></i>Ficha Técnica del Producto
                </h5>
                <span class="badge bg-light text-dark border font-monospace px-3 py-1 fs-6">
                    <i class="bi bi-barcode me-1 text-secondary"></i>@Model.Inventory.Code
                </span>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <!-- Nombre / Descripción -->
                    <div class="col-md-8">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-1">Nombre / Descripción</label>
                        <span class="fs-5 fw-bold text-dark d-block">@Model.Inventory.Name</span>
                    </div>

                    <!-- Estado del Producto (IsActive) -->
                    <div class="col-md-4">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-1">Estado en Catálogo</label>
                        <div>
                            @if (Model.Inventory.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i>Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 fs-6 rounded-pill">
                                    <i class="bi bi-slash-circle-fill me-1"></i>Inactivo
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Estado del Stock -->
                    <div class="col-md-4">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-1">Stock Disponible</label>
                        <div>
                            @if (Model.Inventory.CurrentStock <= 0)
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 fs-6 rounded-2">
                                    <i class="bi bi-x-circle me-1"></i>Agotado (@Model.Inventory.CurrentStock unidades)
                                </span>
                            }
                            else if (Model.Inventory.CurrentStock <= 5)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning-subtle px-3 py-2 fs-6 rounded-2">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Stock Bajo (@Model.Inventory.CurrentStock unidades)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 fs-6 rounded-2">
                                    <i class="bi bi-check-circle me-1"></i>En Stock (@Model.Inventory.CurrentStock unidades)
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Costo -->
                    <div class="col-md-4">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-1">Costo Unitario</label>
                        <span class="fs-5 fw-semibold text-secondary d-block">
                            @Model.Inventory.Cost.ToString("C2")
                        </span>
                    </div>

                    <!-- Precio Venta -->
                    <div class="col-md-4">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-1">Precio de Venta</label>
                        <span class="fs-4 fw-bold text-primary d-block">
                            @Model.Inventory.UnitPrice.ToString("C2")
                        </span>
                    </div>

                    <!-- Margen de Ganancia Estimado -->
                    <div class="col-12">
                        <div class="card bg-light border-0 rounded-3 p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small text-uppercase fw-bold d-block">Ganancia Estimada por Unidad</span>
                                    <span class="fw-bold text-dark">
                                        @((Model.Inventory.UnitPrice - Model.Inventory.Cost).ToString("C2"))
                                    </span>
                                </div>
                                <div class="text-end">
                                    <span class="text-muted small text-uppercase fw-bold d-block">Margen Brutal</span>
                                    <span class="fw-bold text-success">
                                        @(Model.Inventory.UnitPrice > 0
                                            ? (((Model.Inventory.UnitPrice - Model.Inventory.Cost) / Model.Inventory.UnitPrice) * 100).ToString("F1") + "%"
                                            : "0.0%")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Botones de Acción -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="./Index" class="btn btn-light border fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Regresar
                    </a>
                    <a asp-page="./Edit" asp-route-id="@Model.Inventory.Id" class="btn btn-primary fw-semibold px-4 shadow-sm">
                        <i class="bi bi-pencil me-1"></i> Editar Producto
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
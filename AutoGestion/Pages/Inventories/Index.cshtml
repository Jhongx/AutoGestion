@page
@model AutoGestion.Pages.InventoryPages.IndexModel

@{
    ViewData["Title"] = "Inventario de Repuestos y Materiales";
}

<div class="container-fluid px-2 px-md-4 py-3">
    <!-- Encabezado de la Sección con Breadcrumb y Botones de Volver y Registrar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Inicio</a></li>
                    <li class="breadcrumb-item active">Inventario</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1 h3">
                <i class="bi bi-box-seam-fill text-primary me-2"></i>Gestión de Inventario
            </h2>
            <p class="text-muted small mb-0">Control de stock, repuestos y precios de insumos del taller.</p>
        </div>

        <!-- Botones de Acción Superior con hover personalizado -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-page="/Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
            <!-- Ruta corregida apuntando a la carpeta InventoryMovements -->
            <a asp-page="/InventoryMovements/MovementHistory" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-clock-history me-1"></i> <span class="d-none d-sm-inline">Historial</span>
            </a>
            <!-- Entrada: Ruta corregida hacia la nueva carpeta -->
            <a asp-page="/InventoryMovements/Movement" asp-route-type="Inbound" class="btn btn-outline-success fw-semibold shadow-sm custom-hover-success">
                <i class="bi bi-plus-circle me-1"></i> Entrada
            </a>
            <!-- Salida: Ruta corregida hacia la nueva carpeta -->
            <a asp-page="/InventoryMovements/Movement" asp-route-type="Outbound" class="btn btn-outline-danger fw-semibold shadow-sm custom-hover-danger">
                <i class="bi bi-dash-circle me-1"></i> Salida
            </a>
            <a asp-page="Create" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> <span>Nuevo Artículo</span>
            </a>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TARJETAS KPI / RESUMEN -->
    <!-- ========================================== -->
    <!-- Versión Móvil: 1 sola tarjeta compacta resumida (Visible solo en d-block d-md-none) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 d-block d-md-none bg-light">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small text-uppercase fw-bold"><i class="bi bi-speedometer2 me-1"></i> Resumen de Stock</span>
                <span class="badge bg-primary text-white fw-semibold">Total: @Model.Inventory.Count</span>
            </div>
            <div class="row text-center g-2 pt-1 border-top">
                <div class="col-6 border-end">
                    <div class="text-warning small fw-bold"><i class="bi bi-exclamation-triangle"></i> Stock Bajo</div>
                    <span class="fw-bold text-dark fs-5">@Model.Inventory.Count(x => x.CurrentStock <= 5 && x.CurrentStock > 0)</span>
                </div>
                <div class="col-6">
                    <div class="text-danger small fw-bold"><i class="bi bi-x-circle"></i> Agotados</div>
                    <span class="fw-bold text-dark fs-5">@Model.Inventory.Count(x => x.CurrentStock <= 0)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Versión Desktop: 3 tarjetas separadas (Visible solo en d-none d-md-flex) -->
    <div class="row g-3 mb-4 d-none d-md-flex">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-primary border-4 rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Total Ítems</span>
                            <h3 class="fw-bold mb-0 mt-1">@Model.Inventory.Count</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                            <i class="bi bi-box-seam fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-warning border-4 rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Stock Bajo (&le; 5)</span>
                            <h3 class="fw-bold mb-0 mt-1">
                                @Model.Inventory.Count(x => x.CurrentStock <= 5 && x.CurrentStock > 0)
                            </h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                            <i class="bi bi-exclamation-triangle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-danger border-4 rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Agotados</span>
                            <h3 class="fw-bold mb-0 mt-1">
                                @Model.Inventory.Count(x => x.CurrentStock <= 0)
                            </h3>
                        </div>
                        <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle">
                            <i class="bi bi-x-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenedor General de Búsqueda y Registros -->
    <div class="card border-0 shadow-sm rounded-3">
        <!-- Header con Buscador -->
        <div class="card-header bg-white py-3 border-bottom border-light">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <h5 class="card-title text-dark fw-bold mb-0">Catálogo de Productos</h5>
                </div>
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control bg-light border-start-0 ps-0" placeholder="Buscar por código o nombre de repuesto...">
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.Inventory.Any())
        {
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-box-seam fs-1 d-block mb-2 text-secondary opacity-50"></i>
                <span class="fw-medium">No hay productos ni materiales registrados en inventario.</span>
            </div>
        }
        else
        {
            <!-- ========================================== -->
            <!-- 1. VISTA DE TABLA (Visible solo en Desktop / d-none d-md-block) -->
            <!-- ========================================== -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary text-uppercase small border-bottom">
                        <tr>
                            <th class="ps-4 py-3" style="width: 140px;">Código</th>
                            <th class="py-3">Descripción / Repuesto</th>
                            <th class="py-3" style="width: 160px;">Stock Disponible</th>
                            <th class="py-3" style="width: 130px;">Costo</th>
                            <th class="py-3" style="width: 140px;">Precio Venta</th>
                            <th class="py-3" style="width: 110px;">Estado</th>
                            <th class="text-end pe-4 py-3" style="width: 180px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Inventory)
                        {
                            <tr>
                                <!-- Código de Producto -->
                                <td class="ps-4 py-3">
                                    <span class="badge bg-light text-dark border font-monospace px-2 py-1 fs-7">
                                        <i class="bi bi-barcode me-1 text-secondary"></i>@item.Code
                                    </span>
                                </td>

                                <!-- Nombre / Descripción -->
                                <td class="py-3">
                                    <div class="fw-bold text-dark">@item.Name</div>
                                </td>

                                <!-- Stock Actual con Indicador Visual -->
                                <td class="py-3">
                                    @if (item.CurrentStock <= 0)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2.5 py-1 rounded-2">
                                            <i class="bi bi-x-circle me-1"></i>Agotado (@item.CurrentStock)
                                        </span>
                                    }
                                    else if (item.CurrentStock <= 5)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning-subtle px-2.5 py-1 rounded-2">
                                            <i class="bi bi-exclamation-triangle me-1"></i>@item.CurrentStock un.
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2.5 py-1 rounded-2">
                                            <i class="bi bi-check-circle me-1"></i>@item.CurrentStock un.
                                        </span>
                                    }
                                </td>

                                <!-- Costo -->
                                <td class="py-3">
                                    <span class="text-secondary fw-medium">
                                        @item.Cost.ToString("C2")
                                    </span>
                                </td>

                                <!-- Precio Unitario -->
                                <td class="py-3">
                                    <span class="fw-semibold text-dark">
                                        @item.UnitPrice.ToString("C2")
                                    </span>
                                </td>

                                <!-- Estado -->
                                <td class="py-3">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <!-- Acciones Rápidas -->
                                <td class="text-end pe-4 py-3">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Acciones de inventario">
                                        <!-- Botón rápido para mover stock de este ítem -->
                                        <a asp-page="/InventoryMovements/Movement" asp-route-id="@item.Id" class="btn btn-outline-success" title="Registrar Movimiento">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </a>
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Ver Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- ========================================== -->
            <!-- 2. VISTA DE TARJETAS (Visible solo en Móvil / d-block d-md-none) -->
            <!-- ========================================== -->
            <div class="d-block d-md-none p-3 d-flex flex-column gap-3">
                @foreach (var item in Model.Inventory)
                {
                    <div class="card border shadow-none rounded-3 p-3 bg-white">
                        <!-- Cabecera de la tarjeta: Código y Estado -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-light text-dark border font-monospace small">
                                <i class="bi bi-barcode me-1 text-secondary"></i>@item.Code
                            </span>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5 rounded-pill small">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-0.5 rounded-pill small">Inactivo</span>
                            }
                        </div>

                        <!-- Nombre del Repuesto -->
                        <h6 class="fw-bold text-dark mb-2">@item.Name</h6>

                        <!-- Datos Secundarios (Stock y Precios) -->
                        <div class="small text-muted py-2 border-top border-bottom my-2 d-flex flex-column gap-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-stack text-primary me-1"></i> <strong>Stock:</strong></span>
                                @if (item.CurrentStock <= 0)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle">Agotado (@item.CurrentStock)</span>
                                }
                                else if (item.CurrentStock <= 5)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning-subtle">@item.CurrentStock unidades</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">@item.CurrentStock unidades</span>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-tag text-secondary me-1"></i> <strong>Costo:</strong></span>
                                <span class="text-secondary fw-medium">@item.Cost.ToString("C2")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-cash-coin text-success me-1"></i> <strong>Precio Venta:</strong></span>
                                <span class="fw-bold text-dark">@item.UnitPrice.ToString("C2")</span>
                            </div>
                        </div>

                        <!-- Botones de Acción Móvil -->
                        <div class="d-flex flex-column gap-2 mt-1">
                            <a asp-page="/InventoryMovements/Movement" asp-route-id="@item.Id" class="btn btn-success btn-sm w-100 d-flex align-items-center justify-content-center gap-1 fw-semibold">
                                <i class="bi bi-arrow-left-right"></i> Registrar Entrada / Salida de Stock
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-eye"></i> Detalles
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-trash"></i> Eliminar
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Filtro dinámico en cliente por código o nombre
        document.getElementById('searchInput')?.addEventListener('keyup', function () {
            let filter = this.value.toLowerCase();

            // Selector adaptable para filtrar tanto en tabla (desktop) como en tarjetas (móvil)
            let items = document.querySelectorAll('tbody tr, .d-block.d-md-none .card.border.shadow-none');

            items.forEach(item => {
                let text = item.innerText.toLowerCase();
                item.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
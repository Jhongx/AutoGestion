@page
@model AutoGestion.Pages.InventoryPages.CreateModel

@{
    ViewData["Title"] = "Registrar Repuesto / Insumo";
}

<!-- Encabezado de la Página -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-box-seam-fill text-primary me-2"></i>Registrar Repuesto / Insumo
        </h2>
        <p class="text-muted small mb-0">Ingresa los datos del nuevo producto para el inventario del taller.</p>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-info-circle text-primary me-2"></i>Información del Producto
                </h5>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>

                    <div class="row g-3">
                        <!-- Código -->
                        <div class="col-md-6">
                            <label asp-for="Inventory.Code" class="form-label fw-semibold text-dark">Código de Producto</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-barcode"></i></span>
                                <input asp-for="Inventory.Code" class="form-control" placeholder="Ej: REP-1002" />
                            </div>
                            <span asp-validation-for="Inventory.Code" class="text-danger small"></span>
                        </div>

                        <!-- Nombre / Descripción -->
                        <div class="col-md-6">
                            <label asp-for="Inventory.Name" class="form-label fw-semibold text-dark">Nombre del Repuesto <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                                <input asp-for="Inventory.Name" class="form-control" placeholder="Ej: Filtro de Aceite Sintético" />
                            </div>
                            <span asp-validation-for="Inventory.Name" class="text-danger small"></span>
                        </div>

                        <!-- Tipo de Repuesto (Catálogo) -->
                        <div class="col-md-6">
                            <label asp-for="Inventory.InventoryTypeId" class="form-label fw-semibold text-dark">Tipo de Repuesto <span class="text-muted small">(Opcional)</span></label>
                            <div class="input-group">
                                <!-- Ojo: cuando se usa Select2, a veces el input-group requiere un ajuste visual, pero funcionará perfecto -->
                                <select asp-for="Inventory.InventoryTypeId" asp-items="Model.TypeOptions" class="form-select select2-search" data-placeholder="-- Seleccione un tipo --">
                                    <option value=""></option> <!-- Importante para que el allowClear funcione bien -->
                                </select>
                            </div>
                            <span asp-validation-for="Inventory.InventoryTypeId" class="text-danger small"></span>
                        </div>

                        <!-- Marca del Repuesto (Catálogo) -->
                        <div class="col-md-6">
                            <label asp-for="Inventory.InventoryBrandId" class="form-label fw-semibold text-dark">Marca <span class="text-muted small">(Opcional)</span></label>
                            <div class="input-group">
                                <select asp-for="Inventory.InventoryBrandId" asp-items="Model.BrandOptions" class="form-select select2-search" data-placeholder="-- Seleccione una marca --">
                                    <option value=""></option> <!-- Importante para que el allowClear funcione bien -->
                                </select>
                            </div>
                            <span asp-validation-for="Inventory.InventoryBrandId" class="text-danger small"></span>
                        </div>
                        <!-- Stock Inicial -->
                        <div class="col-md-4">
                            <label asp-for="Inventory.CurrentStock" class="form-label fw-semibold text-dark">Stock Inicial <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-boxes"></i></span>
                                <input asp-for="Inventory.CurrentStock" type="number" min="0" class="form-control" placeholder="0" />
                            </div>
                            <span asp-validation-for="Inventory.CurrentStock" class="text-danger small"></span>
                        </div>

                        <!-- Costo -->
                        <div class="col-md-4">
                            <label asp-for="Inventory.Cost" class="form-label fw-semibold text-dark">Costo <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-cash-stack"></i></span>
                                <input asp-for="Inventory.Cost" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Inventory.Cost" class="text-danger small"></span>
                        </div>

                        <!-- Precio Venta -->
                        <div class="col-md-4">
                            <label asp-for="Inventory.UnitPrice" class="form-label fw-semibold text-dark">Precio Venta <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₡</span>
                                <input asp-for="Inventory.UnitPrice" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Inventory.UnitPrice" class="text-danger small"></span>
                        </div>

                        <!-- Estado Inicial (IsActive) -->
                        <div class="col-12 mt-3">
                            <div class="card bg-light border-0 rounded-3 p-3">
                                <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                                    <input asp-for="Inventory.IsActive" class="form-check-input fs-5 mt-0" type="checkbox" role="switch" id="isActiveSwitch" checked>
                                    <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">
                                        Producto Activo en Catálogo
                                    </label>
                                </div>
                                <span class="text-muted small ms-4 ps-2">Determina si el producto estará disponible inmediatamente en las búsquedas y selecciones.</span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Botones de Acción -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="./Index" class="btn btn-light border fw-semibold">Cancelar</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Guardar Producto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- 1. Cargar CSS de Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <!-- 2. Cargar JS de Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- 3. Inicializar Select2 en los selects con clase select2 -->
    <script>
        $(document).ready(function() {
            $('.select2-search').select2({
                theme: 'bootstrap-5',
                placeholder: function() {
                    return $(this).data('placeholder');
                },
                allowClear: true
            });
        });
    </script>
}
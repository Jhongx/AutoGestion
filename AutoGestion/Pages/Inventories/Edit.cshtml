@page "{id:int}"
@model AutoGestion.Pages.InventoryPages.EditModel

@{
    ViewData["Title"] = "Editar Repuesto / Insumo";
}

<!-- Encabezado de la Página -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-pencil-square text-primary me-2"></i>Editar Repuesto / Insumo
        </h2>
        <p class="text-muted small mb-0">Modifica los detalles del producto en el inventario.</p>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-info-circle text-primary me-2"></i>Información del Producto
                </h5>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>

                    <input type="hidden" asp-for="Inventory.Id" />

                    <div class="row g-3">
                        <!-- Código -->
                        <div class="col-md-6">
                            <label asp-for="Inventory.Code" class="form-label fw-semibold text-dark">Código de Producto <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-barcode"></i></span>
                                <input asp-for="Inventory.Code" class="form-control" placeholder="Ej: REP-1002" />
                            </div>
                            <span asp-validation-for="Inventory.Code" class="text-danger small"></span>
                        </div>

                        <!-- Nombre / Descripción -->
                        <div class="col-md-6">
                            <label asp-for="Inventory.Name" class="form-label fw-semibold text-dark">Nombre del Repuesto <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                                <input asp-for="Inventory.Name" class="form-control" placeholder="Ej: Filtro de Aceite Sintético" />
                            </div>
                            <span asp-validation-for="Inventory.Name" class="text-danger small"></span>
                        </div>

                        <!-- Stock Actual -->
                        <div class="col-md-4">
                            <label asp-for="Inventory.CurrentStock" class="form-label fw-semibold text-dark">Stock Disponible <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-boxes"></i></span>
                                <input asp-for="Inventory.CurrentStock" type="number" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="Inventory.CurrentStock" class="text-danger small"></span>
                        </div>

                        <!-- Costo -->
                        <div class="col-md-4">
                            <label asp-for="Inventory.Cost" class="form-label fw-semibold text-dark">Costo <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-cash-stack"></i></span>
                                <input asp-for="Inventory.Cost" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Inventory.Cost" class="text-danger small"></span>
                        </div>

                        <!-- Precio Venta -->
                        <div class="col-md-4">
                            <label asp-for="Inventory.UnitPrice" class="form-label fw-semibold text-dark">Precio Venta <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-currency-dollar"></i></span>
                                <input asp-for="Inventory.UnitPrice" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Inventory.UnitPrice" class="text-danger small"></span>
                        </div>

                        <!-- Estado (IsActive) -->
                        <div class="col-12 mt-3">
                            <div class="card bg-light border-0 rounded-3 p-3">
                                <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                                    <input asp-for="Inventory.IsActive" class="form-check-input fs-5 mt-0" type="checkbox" role="switch" id="isActiveSwitch">
                                    <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">
                                        Producto Activo en Catálogo
                                    </label>
                                </div>
                                <span class="text-muted small ms-4 ps-2">Si se desactiva, el producto no estará disponible para nuevas órdenes o selecciones.</span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Botones de Acción -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="./Index" class="btn btn-light border fw-semibold">Cancelar</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@page
@model AutoGestion.Pages.InspectionAppointments.DetailsModel
@{
    ViewData["Title"] = "Detalles de la Cita";
}

<div class="container-fluid px-4 py-3">
    <!-- Header principal con breadcrumb y acciones -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="./Index" class="text-decoration-none">Citas</a></li>
                    <li class="breadcrumb-item"><a asp-page="./Calendar" class="text-decoration-none">Calendario</a></li>
                    <li class="breadcrumb-item active">Detalles</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 text-dark fw-bold m-0">Cita de Inspección</h1>
                <span class="badge bg-secondary bg-opacity-10 text-secondary border font-monospace fs-6">#@Model.InspectionAppointment.Id.ToString("D5")</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-page="./Edit" asp-route-id="@Model.InspectionAppointment.Id" class="btn btn-sm btn-warning fw-semibold px-3 py-2 shadow-sm d-flex align-items-center gap-1">
                <i class="bi bi-pencil-fill"></i>
                <span>Editar</span>
            </a>
            <a asp-page="./Index" class="btn btn-sm btn-outline-secondary px-3 py-2 shadow-sm d-flex align-items-center gap-1">
                <i class="bi bi-list-ul"></i>
                <span>Listado</span>
            </a>
            <a asp-page="./Calendar" class="btn btn-sm btn-outline-secondary px-3 py-2 shadow-sm d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>
                <span>Calendario</span>
            </a>
        </div>
    </div>

    <!-- Contenido Principal Centrado (Más compacto) -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <!-- Barra superior de estado visual -->
                <div class="card-header bg-light py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                    <span class="text-uppercase small text-muted fw-bold" style="font-size: 0.75rem;">Resumen de la Programación</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill px-2 py-1 fw-semibold small">
                        <i class="bi bi-check-circle-fill me-1"></i> @Model.InspectionAppointment.Status
                    </span>
                </div>

                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">

                        <!-- Bloque 1: Fecha y Horario (Compacto en una sola fila dividida) -->
                        <div class="col-12">
                            <div class="p-2 px-3 bg-light rounded-3 border border-light-subtle">
                                <div class="row g-2 align-items-center text-center text-md-start">
                                    <div class="col-md-6 d-flex align-items-center gap-2">
                                        <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-2 fs-6 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <i class="bi bi-calendar-event"></i>
                                        </div>
                                        <div>
                                            <span class="text-muted d-block" style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700;">Fecha</span>
                                            <span class="fw-bold text-dark">@Model.InspectionAppointment.AppointmentDate.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6 d-flex align-items-center gap-2 ps-md-3 border-start-md">
                                        <div class="bg-success bg-opacity-10 text-success p-2 rounded-2 fs-6 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <i class="bi bi-clock-history"></i>
                                        </div>
                                        <div>
                                            <span class="text-muted d-block" style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700;">Horario</span>
                                            <span class="fw-bold text-dark">@Model.InspectionAppointment.StartTime - @Model.InspectionAppointment.EndTime</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Bloque 2: Cliente y Vehículo -->
                        <div class="col-md-6">
                            <div class="card h-100 border border-light-subtle shadow-none bg-white rounded-3 p-2 px-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-info bg-opacity-10 text-info p-2 rounded-2 fs-6" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div class="overflow-hidden">
                                        <span class="text-muted d-block" style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700;">Cliente</span>
                                        <h6 class="fw-bold text-dark mb-0 text-truncate">@Model.InspectionAppointment.Client?.FirstName @Model.InspectionAppointment.Client?.LastName</h6>
                                        <span class="text-muted" style="font-size: 0.8rem;"><i class="bi bi-telephone text-secondary me-1"></i>@(string.IsNullOrEmpty(Model.InspectionAppointment.Client?.PrimaryPhone) ? "Sin teléfono" : Model.InspectionAppointment.Client.PrimaryPhone)</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card h-100 border border-light-subtle shadow-none bg-white rounded-3 p-2 px-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-warning bg-opacity-10 text-warning p-2 rounded-2 fs-6" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-car-front-fill"></i>
                                    </div>
                                    <div class="overflow-hidden">
                                        <span class="text-muted d-block" style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700;">Vehículo</span>
                                        <h6 class="fw-bold text-dark mb-1 text-truncate">@Model.InspectionAppointment.Vehicle?.Brand @Model.InspectionAppointment.Vehicle?.Model</h6>
                                        <span class="badge bg-light text-dark border font-monospace" style="font-size: 0.7rem;">
                                            <i class="bi bi-card-heading me-1 text-secondary"></i>@Model.InspectionAppointment.Vehicle?.LicensePlate
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Bloque 3: Tipo de Inspección -->
                        <div class="col-12">
                            <div class="d-flex align-items-center justify-content-between p-2 px-3 bg-light rounded-3 border border-light-subtle">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-tools text-primary"></i>
                                    <span class="text-secondary fw-semibold small">Tipo de Inspección:</span>
                                </div>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-1 fw-semibold small">
                                    @Model.InspectionAppointment.InspectionType
                                </span>
                            </div>
                        </div>

                        <!-- Bloque 4: Motivo / Sintomatología -->
                        <div class="col-12">
                            <span class="text-muted d-block mb-1" style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700;">
                                <i class="bi bi-chat-left-text me-1"></i> Motivo / Sintomatología Reportada
                            </span>
                            <div class="p-2 px-3 bg-light rounded-3 border border-light-subtle text-secondary small" style="min-height: 60px; white-space: pre-line;">
                                @(string.IsNullOrEmpty(Model.InspectionAppointment.Reason) ? "Sin observaciones registradas para esta cita." : Model.InspectionAppointment.Reason)
                            </div>
                        </div>

                    </div>

                    <!-- Botón clave para el flujo hacia el taller -->
                    <div class="mt-4 pt-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                        <span class="text-muted" style="font-size: 0.8rem;">
                            <i class="bi bi-info-circle me-1"></i> ¿El vehículo llegó al taller?
                        </span>
                        <a asp-page="/ReceivingOrders/Create"
                           asp-route-appointmentId="@Model.InspectionAppointment.Id"
                           asp-route-clientId="@Model.InspectionAppointment.ClientId"
                           asp-route-vehicleId="@Model.InspectionAppointment.VehicleId"
                           asp-route-reason="@Model.InspectionAppointment.Reason"
                           class="btn btn-sm btn-success fw-semibold px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Recibir en Taller (Crear Orden)</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
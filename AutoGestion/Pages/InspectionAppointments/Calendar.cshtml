@page
@model AutoGestion.Pages.InspectionAppointments.CalendarModel
@{
    ViewData["Title"] = "Calendario de Citas de Inspección";
}

<!-- FullCalendar JS -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

<div class="container-fluid px-2 px-md-4 py-3">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="./Index" class="text-decoration-none">Citas de Inspección</a></li>
                    <li class="breadcrumb-item active">Calendario</li>
                </ol>
            </nav>
            <h1 class="h3 text-dark fw-bold m-0">
                <i class="bi bi-calendar-check text-primary me-2"></i>Agenda de Citas de Inspección
            </h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Create" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Nueva Cita
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-list-ul me-1"></i> Ver Tabla
            </a>
        </div>
    </div>

    <!-- Leyenda por Estado -->
    <div class="d-flex gap-2 gap-md-3 mb-3 flex-wrap align-items-center bg-white p-3 rounded-3 border shadow-sm">
        <span class="fw-bold small text-muted text-uppercase w-100 w-sm-auto mb-1 mb-sm-0">Estado:</span>
        <span class="badge bg-primary px-2 px-md-3 py-2 fs-7"><i class="bi bi-circle-fill me-1 small"></i> Programada</span>
        <span class="badge bg-success px-2 px-md-3 py-2 fs-7"><i class="bi bi-circle-fill me-1 small"></i> Confirmada</span>
        <span class="badge bg-secondary px-2 px-md-3 py-2 fs-7"><i class="bi bi-circle-fill me-1 small"></i> Convertida a Orden</span>
        <span class="badge bg-danger px-2 px-md-3 py-2 fs-7"><i class="bi bi-circle-fill me-1 small"></i> Cancelada</span>
    </div>

    <div class="row g-3 g-md-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-2 p-md-4">
                    <div id="calendar" data-events='@Html.Raw(Model.EventsJson)'></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold text-dark m-0">
                        <i class="bi bi-clock-history text-primary me-2"></i>Citas del Día
                    </h5>
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold" id="selectedDateBadge">
                        Hoy
                    </span>
                </div>
                <div class="card-body p-3 overflow-auto" style="max-height: 620px;">
                    <div id="sidePanelOrdersList" class="d-flex flex-column gap-3">
                        <!-- Carga dinámica vía JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/InspectionAppointments/CalendarAppointments.js" asp-append-version="true"></script>
}
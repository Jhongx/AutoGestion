@page
@model AutoGestion.Pages.InspectionAppointments.CalendarModel
@{
    ViewData["Title"] = "Calendario de Citas de Inspección";
}

<!-- FullCalendar JS -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

<div class="container-fluid px-2 px-md-4 py-3">
    <!-- Encabezado de la Sección con Breadcrumb y Botones Compactos -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="./Index" class="text-decoration-none">Citas de Inspección</a></li>
                    <li class="breadcrumb-item active">Calendario</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0 h3">
                <i class="bi bi-calendar-check text-primary me-2"></i>Agenda de Citas
            </h2>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-page="./Index" class="btn btn-outline-secondary fw-semibold shadow-sm flex-fill flex-sm-grow-0">
                <i class="bi bi-list-ul me-1"></i> Ver Tabla
            </a>
            <a asp-page="./Create" class="btn btn-primary fw-semibold shadow-sm flex-fill flex-sm-grow-0">
                <i class="bi bi-plus-lg me-1"></i> Nueva Cita
            </a>
        </div>
    </div>

    <!-- Leyenda por Estado Restaurada y Legible -->
    <div class="bg-white p-2.5 rounded-3 border shadow-sm mb-3">
        <span class="fw-bold text-muted text-uppercase small d-block mb-2">Estados de Cita:</span>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <span class="badge text-white px-2 py-1 fs-8" style="background-color: #0d6efd;">
                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Programada
            </span>
            <span class="badge text-white px-2 py-1 fs-8" style="background-color: #198754;">
                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Confirmada
            </span>
            <span class="badge text-dark px-2 py-1 fs-8" style="background-color: #ffc107;">
                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Convertida a Orden
            </span>
            <span class="badge text-white px-2 py-1 fs-8" style="background-color: #6c757d;">
                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Cancelada
            </span>
        </div>
    </div>

    <!-- Navegación por Pestañas exclusiva para móvil / Diseño limpio en Desktop -->
    <ul class="nav nav-pills nav-fill mb-3 d-lg-none bg-white p-1 rounded-3 border shadow-sm" id="calendarTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active py-2 fw-semibold small" id="calendar-tab" data-bs-toggle="tab" data-bs-target="#calendar-pane" type="button" role="tab">
                <i class="bi bi-calendar3 me-1"></i> Calendario
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link py-2 fw-semibold small" id="appointments-tab" data-bs-toggle="tab" data-bs-target="#appointments-pane" type="button" role="tab">
                <i class="bi bi-clock-history me-1"></i> Citas del Día <span class="badge bg-danger ms-1" id="mobileBadgeCount">0</span>
            </button>
        </li>
    </ul>

    <!-- Contenido Principal en Grid / Tabs -->
    <div class="tab-content row g-3 g-md-4">
        <!-- Panel del Calendario -->
        <div class="col-lg-8 tab-pane fade show active d-lg-block" id="calendar-pane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-2 p-md-4">
                    <div id="calendar" data-events='@Html.Raw(Model.EventsJson)'></div>
                </div>
            </div>
        </div>

        <!-- Panel Lateral / Pestaña de Citas del Día -->
        <div class="col-lg-4 tab-pane fade d-lg-block" id="appointments-pane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold text-dark m-0 fs-6">
                        <i class="bi bi-clock-history text-primary me-2"></i>Citas del Día
                    </h5>
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold small" id="selectedDateBadge">
                        Hoy
                    </span>
                </div>
                <div class="card-body p-3 overflow-auto" style="max-height: 550px;">
                    <div id="sidePanelOrdersList" class="d-flex flex-column gap-3">
                        <!-- Carga dinámica vía JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/InspectionAppointments/CalendarAppointments.js" asp-append-version="true"></script>
    <script>
        // Sincronizar dinámicamente el contador del badge móvil según las tarjetas cargadas en el panel
        document.addEventListener("DOMContentLoaded", function () {
            const container = document.getElementById('sidePanelOrdersList');
            const badge = document.getElementById('mobileBadgeCount');

            if (container && badge) {
                const observer = new MutationObserver(function () {
                    // Contar cuántas tarjetas de citas hay renderizadas actualmente
                    const cards = container.querySelectorAll('.card, .appointment-item, .alert, .border');
                    // O si las tarjetas usan un selector específico, ajustamos el conteo por hijos directos o elementos de cita
                    const count = container.children.length;

                    // Si el contenedor muestra el mensaje de "no hay citas", el conteo es 0
                    const hasNoAppointments = container.innerText.toLowerCase().includes('no hay') || count === 0;
                    badge.textContent = hasNoAppointments ? 0 : count;
                });

                observer.observe(container, { childList: true, subtree: true });
            }
        });
    </script>
}

<style>
    /* Estilo exclusivo para remarcar la celda del día seleccionado sin romper eventos */
    .fc-daygrid-day.fc-day-selected {
        background-color: #e7f1ff !important;
        box-shadow: inset 0 0 0 2px #0d6efd !important;
    }

    .fc-daygrid-day {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

        .fc-daygrid-day:hover:not(.fc-day-selected) {
            background-color: rgba(13, 110, 253, 0.05) !important;
        }

    /* Ajustes específicos para móviles en la barra de herramientas del calendario */
    @@media (max-width: 991.98px) {
        .fc-toolbar {
            flex-direction: column;
            gap: 6px;
        }

        .fc-toolbar-title {
            font-size: 1rem !important;
        }

        .fc-header-toolbar {
            margin-bottom: 0.4rem !important;
        }

        .tab-pane.fade:not(.show) {
            display: none;
        }
    }

    @@media (min-width: 992px) {
        .tab-pane.fade {
            display: block !important;
            opacity: 1 !important;
        }
    }
</style>
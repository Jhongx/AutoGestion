@page
@model AutoGestion.Pages.InspectionAppointments.IndexModel

@{
    ViewData["Title"] = "Listado de Citas de Inspección";
}

<div class="container-fluid px-3 px-md-4 py-3">
    <!-- Header principal con grupo de acciones -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 text-dark fw-bold m-0">Citas de Inspección</h1>
            <p class="text-muted small mb-0">Gestión de la agenda, programación y estado de citas</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-page="./Calendar" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 px-3 py-2 shadow-sm fw-semibold flex-fill justify-content-center">
                <i class="bi bi-calendar-check"></i>
                <span>Ver Calendario</span>
            </a>
            <a asp-page="./Create" class="btn btn-primary btn-sm d-flex align-items-center gap-2 px-3 py-2 shadow-sm fw-semibold flex-fill justify-content-center">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Nueva Cita</span>
            </a>
        </div>
    </div>

    <!-- Tarjetas de resumen / KPIs -->
    <div class="row g-2 g-md-3 mb-4">
        <div class="col-4">
            <div class="card border-0 shadow-sm border-start border-primary border-3 rounded-3 h-100">
                <div class="card-body p-3">
                    <span class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Totales</span>
                    <h3 class="fw-bold mb-0 mt-1 fs-4">@Model.InspectionAppointments.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card border-0 shadow-sm border-start border-success border-3 rounded-3 h-100">
                <div class="card-body p-3">
                    <span class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Hoy</span>
                    <h3 class="fw-bold mb-0 mt-1 fs-4">
                        @Model.InspectionAppointments.Count(x => x.AppointmentDate == DateOnly.FromDateTime(DateTime.Today))
                    </h3>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card border-0 shadow-sm border-start border-warning border-3 rounded-3 h-100">
                <div class="card-body p-3">
                    <span class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Tipos</span>
                    <h3 class="fw-bold mb-0 mt-1 fs-4">
                        @Model.InspectionAppointments.Select(x => x.InspectionType).Distinct().Count()
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenedor Principal con Buscador y Filtros -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom border-light">
            <div class="row align-items-center g-3">
                <div class="col-12 col-lg-5">
                    <h5 class="card-title text-dark fw-bold mb-0 fs-6">Citas Registradas</h5>
                </div>
                <div class="col-12 col-lg-7">
                    <div class="d-flex flex-column gap-2">
                        <!-- Buscador -->
                        <div class="input-group input-group-sm w-100">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="searchInput" class="form-control bg-light border-start-0 ps-0" placeholder="Buscar por cliente, vehículo o motivo...">
                        </div>
                        <!-- Filtros rápidos por estado (Píldoras adaptables) -->
                        <div class="d-flex gap-1" role="group" aria-label="Filtro rápido por estado">
                            <button type="button" class="btn btn-outline-secondary btn-sm active filter-btn flex-fill" data-filter="all">Todas</button>
                            <button type="button" class="btn btn-outline-success btn-sm filter-btn flex-fill" data-filter="completada">Completadas</button>
                            <button type="button" class="btn btn-outline-warning btn-sm filter-btn flex-fill" data-filter="pendiente">Pendientes</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- VISTA DE ESCRITORIO: Tabla tradicional (Oculta en móviles) -->
        <div class="table-responsive d-none d-lg-block">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase small border-bottom">
                    <tr>
                        <th class="ps-4 py-3" style="width: 150px;">Fecha / Hora</th>
                        <th class="py-3" style="width: 200px;">Cliente</th>
                        <th class="py-3" style="width: 200px;">Vehículo</th>
                        <th class="py-3" style="width: 160px;">Tipo / Estado</th>
                        <th class="py-3">Motivo</th>
                        <th class="text-end pe-4 py-3" style="width: 140px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.InspectionAppointments.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <span class="fw-medium">No hay citas de inspección registradas.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.InspectionAppointments)
                        {
                            var statusLower = (item.Status ?? "").ToLower();
                            <tr data-status="@statusLower" data-search-text="@item.AppointmentDate.ToString("dd/MM/yyyy") @(item.Client?.FirstName) @(item.Client?.LastName) @(item.Vehicle?.Brand) @(item.Vehicle?.Model) @(item.Vehicle?.LicensePlate) @item.InspectionType @item.Status @item.Reason" .ToLower()>
                                <td class="ps-4 py-3">
                                    <div class="fw-bold text-dark"><i class="bi bi-calendar3 me-1 text-primary"></i>@item.AppointmentDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small"><i class="bi bi-clock me-1"></i>@item.StartTime - @item.EndTime</div>
                                </td>
                                <td class="py-3">
                                    @if (item.Client != null)
                                    {
                                        <div class="fw-bold text-dark">@item.Client.FirstName @item.Client.LastName</div>
                                        <div class="text-muted small">@item.Client.PrimaryPhone</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Cliente #@item.ClientId</span>
                                    }
                                </td>
                                <td class="py-3">
                                    @if (item.Vehicle != null)
                                    {
                                        <div class="fw-bold text-dark mb-1">@item.Vehicle.Brand @item.Vehicle.Model</div>
                                        <span class="badge bg-light text-dark border font-monospace small"><i class="bi bi-card-heading me-1 text-secondary"></i>@item.Vehicle.LicensePlate</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin vehículo</span>
                                    }
                                </td>
                                <td class="py-3">
                                    <div class="mb-1"><span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-2 px-2 py-1 fw-semibold">@item.InspectionType</span></div>
                                    <div>
                                        @{
                                            var badgeClassDesktop = statusLower.Contains("complet") ? "bg-success bg-opacity-10 text-success border border-success-subtle" :
                                                                  statusLower.Contains("pend") ? "bg-warning bg-opacity-10 text-warning border border-warning-subtle" :
                                                                  "bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle";
                                        }
                                        <span class="badge @badgeClassDesktop rounded-2 px-2 py-1 fw-semibold small">@item.Status</span>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="text-truncate text-secondary" style="max-width: 250px;" title="@item.Reason">
                                        @(string.IsNullOrWhiteSpace(item.Reason) ? "Sin observaciones" : item.Reason)
                                    </div>
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-light border text-body" title="Ver Detalles"><i class="bi bi-eye"></i></a>
                                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-light border text-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-light border text-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- VISTA MÓVIL: Tarjetas individuales (Visible solo en pantallas pequeñas) -->
        <div class="d-block d-lg-none p-3 bg-light">
            @if (!Model.InspectionAppointments.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                    <span class="fw-medium">No hay citas de inspección registradas.</span>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.InspectionAppointments)
                    {
                        var statusLower = (item.Status ?? "").ToLower();
                        <div class="card border-0 shadow-sm rounded-3 p-3 mobile-card" data-status="@statusLower" data-search-text="@item.AppointmentDate.ToString("dd/MM/yyyy") @(item.Client?.FirstName) @(item.Client?.LastName) @(item.Vehicle?.Brand) @(item.Vehicle?.Model) @(item.Vehicle?.LicensePlate) @item.InspectionType @item.Status @item.Reason" .ToLower()>

                            <!-- Cabecera de la Tarjeta Móvil: Fecha y Estado -->
                            <div class="d-flex justify-content-between align-items-start mb-2 border-bottom pb-2">
                                <div>
                                    <div class="fw-bold text-dark small">
                                        <i class="bi bi-calendar3 me-1 text-primary"></i>@item.AppointmentDate.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        <i class="bi bi-clock me-1"></i>@item.StartTime - @item.EndTime
                                    </div>
                                </div>
                                <div>
                                    @{
                                        var badgeClassMobile = statusLower.Contains("complet") ? "bg-success bg-opacity-10 text-success border border-success-subtle" :
                                                               statusLower.Contains("pend") ? "bg-warning bg-opacity-10 text-warning border border-warning-subtle" :
                                                               "bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle";
                                    }
                                    <span class="badge @badgeClassMobile rounded-2 px-2 py-1 fw-semibold" style="font-size: 0.7rem;">@item.Status</span>
                                </div>
                            </div>

                            <!-- Cuerpo de la Tarjeta Móvil: Detalles -->
                            <div class="mb-2">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-0.5" style="font-size: 0.7rem;">@item.InspectionType</span>
                                </div>

                                <div class="small mb-1">
                                    <span class="text-muted">Cliente:</span>
                                    <span class="fw-bold text-dark">@(item.Client != null ? $"{item.Client.FirstName} {item.Client.LastName}" : $"Cliente #{item.ClientId}")</span>
                                </div>

                                <div class="small mb-1">
                                    <span class="text-muted">Vehículo:</span>
                                    @if (item.Vehicle != null)
                                    {
                                        <span class="fw-medium text-dark">@item.Vehicle.Brand @item.Vehicle.Model</span>
                                        <span class="text-muted font-monospace" style="font-size: 0.75rem;">(@item.Vehicle.LicensePlate)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin vehículo</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.Reason))
                                {
                                    <div class="text-muted small mt-2 bg-light p-2 rounded-2" style="font-size: 0.75rem;">
                                        <i class="bi bi-chat-left-text me-1"></i> @item.Reason
                                    </div>
                                }
                            </div>

                            <!-- Botones de Acción Móvil -->
                            <div class="d-flex justify-content-end gap-1 pt-2 border-top">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm px-2 py-1" title="Ver Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm px-2 py-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm px-2 py-1" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>

                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const filterButtons = document.querySelectorAll('.filter-btn');
            // Seleccionamos tanto filas de tabla como tarjetas móviles
            const items = document.querySelectorAll('tr[data-status], .mobile-card');

            let currentFilter = 'all';
            let currentSearch = '';

            function applyFilters() {
                items.forEach(item => {
                    const status = item.getAttribute('data-status');
                    const searchText = item.getAttribute('data-search-text') || '';

                    const matchesFilter = (currentFilter === 'all' || status.includes(currentFilter));
                    const matchesSearch = searchText.includes(currentSearch);

                    if (matchesFilter && matchesSearch) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });
            }

            // Evento de búsqueda de texto
            searchInput?.addEventListener('keyup', function () {
                currentSearch = this.value.toLowerCase();
                applyFilters();
            });

            // Eventos para los botones de filtrado rápido
            filterButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    // Remover estilos activos de todos los botones de su grupo
                    const parentGroup = this.parentElement;
                    parentGroup.querySelectorAll('.filter-btn').forEach(b => {
                        b.classList.remove('active', 'btn-secondary', 'btn-success', 'btn-warning');
                        if (b.dataset.filter === 'all') b.className = 'btn btn-outline-secondary btn-sm filter-btn flex-fill';
                        if (b.dataset.filter === 'completada') b.className = 'btn btn-outline-success btn-sm filter-btn flex-fill';
                        if (b.dataset.filter === 'pendiente') b.className = 'btn btn-outline-warning btn-sm filter-btn flex-fill';
                    });

                    this.classList.add('active');
                    currentFilter = this.dataset.filter;

                    // Aplicar color sólido al botón activo
                    if (currentFilter === 'all') this.classList.replace('btn-outline-secondary', 'btn-secondary');
                    if (currentFilter === 'completada') this.classList.replace('btn-outline-success', 'btn-success');
                    if (currentFilter === 'pendiente') this.classList.replace('btn-outline-warning', 'btn-warning');

                    applyFilters();
                });
            });
        });
    </script>
}
@page
@model AutoGestion.Pages.InspectionAppointments.PrintPdfModel
@{
    ViewData["Title"] = "Comprobante de Cita #" + Model.InspectionAppointment.Id.ToString("D5");
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 CSS via CDN (Funciona garantizado en local y en producción) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Bootstrap Icons via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            body {
                background-color: #ffffff;
                color: #212529;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                font-size: 14px;
                margin: 0;
                padding: 0;
            }

            .document-container {
                max-width: 800px;
                margin: 0 auto;
                padding: 15px;
            }

            .section-title {
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                font-weight: 700;
                color: #6c757d;
                border-bottom: 2px solid #0d6efd;
                padding-bottom: 4px;
                margin-bottom: 12px;
            }

            @@media (min-width: 768px) {
                .document-container {
                    padding: 30px;
                }
            }

            @@media print {
                .no-print {
                    display: none !important;
                }

                .document-container {
                    padding: 0;
                    max-width: 100%;
                }

                @@page {
                    margin: 1cm;
                }
            }
    </style>
</head>
<body onload="window.print();">

    <!-- Barra de acciones superior adaptable -->
    <div class="py-2 px-3 bg-light border-bottom no-print d-flex flex-column flex-sm-row justify-content-center align-items-center gap-2">
        <button onclick="window.print();" class="btn btn-primary btn-sm px-4 fw-semibold shadow-sm w-100 w-sm-auto">
            <i class="bi bi-printer me-1"></i> Imprimir / Guardar PDF
        </button>
        <button onclick="window.close();" class="btn btn-outline-secondary btn-sm px-3 fw-semibold shadow-sm w-100 w-sm-auto">
            <i class="bi bi-x-lg me-1"></i> Cerrar Ventana
        </button>
    </div>

    <!-- Contenedor principal del documento -->
    <div class="document-container">
        
        <!-- Encabezado Corporativo Responsivo -->
        <div class="row border-bottom pb-3 mb-3 align-items-center text-center text-sm-start g-2">
            <div class="col-12 col-sm-7">
                <h3 class="fw-bold text-primary mb-0" style="letter-spacing: -0.5px;">AutoGestión</h3>
                <span class="text-muted small">Sistema de Control y Talleres Mecánicos</span>
            </div>
            <div class="col-12 col-sm-5 text-sm-end mt-2 mt-sm-0">
                <span class="d-block fw-bold text-dark small" style="font-size: 0.75rem; letter-spacing: 0.5px;">COMPROBANTE DE CITA</span>
                <span class="badge bg-dark font-monospace px-2 py-1 fs-6 mt-1">#@Model.InspectionAppointment.Id.ToString("D5")</span>
            </div>
        </div>

        <!-- Info General: Estado y Tipo -->
        <div class="row mb-3 bg-light p-2.5 rounded-2 align-items-center g-2 text-center text-sm-start">
            <div class="col-12 col-sm-6">
                <span class="text-muted d-block small fw-bold" style="font-size: 0.7rem;">ESTADO DE LA CITA</span>
                <span class="fw-bold text-success fs-6">● @Model.InspectionAppointment.Status</span>
            </div>
            <div class="col-12 col-sm-6 text-sm-end border-top border-sm-top-0 pt-2 pt-sm-0">
                <span class="text-muted d-block small fw-bold" style="font-size: 0.7rem;">TIPO DE INSPECCIÓN</span>
                <span class="fw-semibold text-dark fs-6">@Model.InspectionAppointment.InspectionType</span>
            </div>
        </div>

        <!-- Bloque Central: Fecha y Hora Destacada -->
        <div class="text-center border border-primary-subtle bg-primary bg-opacity-10 p-3 rounded-2 mb-3">
            <span class="text-primary text-uppercase fw-bold small d-block mb-1" style="font-size: 0.7rem;">
                <i class="bi bi-calendar-check me-1"></i> Fecha y Horario Programado
            </span>
            <h4 class="fw-bold text-dark mb-1 fs-5 fs-sm-4">
                @Model.InspectionAppointment.AppointmentDate.ToString("dddd, dd 'de' MMMM 'de' yyyy")
            </h4>
            <div class="fs-6 fw-bold text-primary">
                <i class="bi bi-clock me-1"></i> @Model.InspectionAppointment.StartTime - @Model.InspectionAppointment.EndTime
            </div>
        </div>

        <!-- Sección: Datos del Cliente y Vehículo (Apilados en móvil, lado a lado en desktop) -->
        <div class="row mb-3 g-3">
            <!-- Cliente -->
            <div class="col-12 col-md-6">
                <div class="border p-3 rounded-2 h-100 bg-white shadow-2xs">
                    <div class="section-title"><i class="bi bi-person-fill me-1"></i> Datos del Cliente</div>
                    <p class="mb-1"><strong>Nombre:</strong> @Model.InspectionAppointment.Client?.FirstName @Model.InspectionAppointment.Client?.LastName</p>
                    <p class="mb-0"><strong>Teléfono:</strong> @(string.IsNullOrEmpty(Model.InspectionAppointment.Client?.PrimaryPhone) ? "No registrado" : Model.InspectionAppointment.Client.PrimaryPhone)</p>
                </div>
            </div>
            <!-- Vehículo -->
            <div class="col-12 col-md-6">
                <div class="border p-3 rounded-2 h-100 bg-white shadow-2xs">
                    <div class="section-title"><i class="bi bi-car-front-fill me-1"></i> Datos del Vehículo</div>
                    <p class="mb-1"><strong>Vehículo:</strong> @Model.InspectionAppointment.Vehicle?.Brand @Model.InspectionAppointment.Vehicle?.Model</p>
                    <p class="mb-0"><strong>Placa:</strong> <span class="font-monospace text-dark fw-bold bg-light px-2 py-0.5 border rounded">@Model.InspectionAppointment.Vehicle?.LicensePlate</span></p>
                </div>
            </div>
        </div>

        <!-- Sección: Motivo / Sintomatología -->
        <div class="mb-4">
            <div class="section-title"><i class="bi bi-chat-left-text me-1"></i> Motivo / Sintomatología Reportada</div>
            <div class="p-3 bg-light rounded-2 text-secondary border small" style="min-height: 70px; white-space: pre-line;">
                @(string.IsNullOrEmpty(Model.InspectionAppointment.Reason) ? "Sin observaciones registradas para esta cita." : Model.InspectionAppointment.Reason)
            </div>
        </div>

        <!-- Pie de página / Términos -->
        <div class="text-center text-muted border-top pt-3 mt-auto small">
            <p class="fw-bold mb-1 text-dark" style="font-size: 0.85rem;">¡Gracias por confiar en nuestros servicios!</p>
            <p class="mb-0 text-muted" style="font-size: 0.8rem;">Le solicitamos presentarse con su vehículo 10 minutos antes de la hora programada en el taller.</p>
            <div class="mt-2 text-secondary" style="font-size: 0.7rem;">
                Comprobante emitido digitalmente el @DateTime.Now.ToString("dd/MM/yyyy HH:mm") — AutoGestión Taller
            </div>
        </div>

    </div>

</body>
</html>
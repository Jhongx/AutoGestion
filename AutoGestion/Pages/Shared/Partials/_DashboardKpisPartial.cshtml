<div class="row g-2 g-md-3 mb-3 mb-md-4">
    <!-- KPI 1: Total Repuestos Activos -->
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-2 p-md-3 d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 p-md-3 me-2 me-md-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; width-md: 54px; height-md: 54px;">
                    <i class="bi bi-box-seam fs-6 fs-md-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-0" style="font-size: 0.75rem;">Inventario</span>
                    <h5 class="fw-bold text-dark mb-0">@Model.TotalItemsInInventory</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 2: Alertas de Stock Bajo -->
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-2 p-md-3 d-flex align-items-center">
                <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-2 p-md-3 me-2 me-md-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                    <i class="bi bi-exclamation-triangle-fill fs-6 fs-md-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-0" style="font-size: 0.75rem;">Stock Bajo</span>
                    <h5 class="fw-bold text-danger mb-0">@Model.LowStockItemsCount</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 3: Valor Estimado del Inventario -->
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-2 p-md-3 d-flex align-items-center">
                <div class="bg-success bg-opacity-10 text-success rounded-3 p-2 p-md-3 me-2 me-md-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                    <i class="bi bi-currency-dollar fs-6 fs-md-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-0" style="font-size: 0.75rem;">Valor Total</span>
                    <h5 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">@Model.TotalInventoryValue.ToString("N0")</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 4: Órdenes Activas en Taller -->
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-2 p-md-3 d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-2 p-md-3 me-2 me-md-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                    <i class="bi bi-tools fs-6 fs-md-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-0" style="font-size: 0.75rem;">En Taller</span>
                    <h5 class="fw-bold text-dark mb-0">@Model.ActiveReceivingOrders</h5>
                </div>
            </div>
        </div>
    </div>
</div>
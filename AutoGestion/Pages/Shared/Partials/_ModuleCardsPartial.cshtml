<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 g-md-4">

    <!-- Módulo Clientes -->
    <div class="col">
        <div class="card h-100 shadow-sm border-0 rounded-3">
            <div class="card-body text-center d-none d-md-flex flex-column p-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
                <h5 class="card-title fw-bold text-dark mb-1">Clientes</h5>
                <p class="card-text text-muted small mb-4">Gestión de expedientes de clientes y datos de contacto.</p>
                <a asp-page="/Clients/Index" class="btn btn-outline-primary fw-semibold btn-sm w-100 mt-auto">
                    <i class="bi bi-arrow-right me-1"></i> Ver Clientes
                </a>
            </div>
            <div class="card-body p-3 d-flex d-md-none align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 48px; height: 48px;">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
                <div class="flex-grow-1 me-2">
                    <h6 class="fw-bold text-dark mb-0">Clientes</h6>
                    <span class="text-muted small">Expedientes y contactos</span>
                </div>
                <a asp-page="/Clients/Index" class="btn btn-primary btn-sm px-3 fw-semibold shadow-sm flex-shrink-0">
                    Ver <i class="bi bi-chevron-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>


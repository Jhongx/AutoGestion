<!-- Hero / Banner Principal -->
<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden bg-dark text-white position-relative">
    <div class="card-body p-4 p-md-5 position-relative z-1" style="background: linear-gradient(135deg, rgba(13,110,253,0.15) 0%, rgba(33,37,41,0) 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <!-- Badge con texto visible -->
                <span class="badge bg-primary bg-opacity-20 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-semibold mb-3 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-shield-check"></i> AutoGestión v1.0
                </span>

                <h1 class="display-6 fw-bold mb-2">Panel de Control General</h1>

                <!-- Texto largo: Solo se muestra en escritorio (lg o mayor) -->

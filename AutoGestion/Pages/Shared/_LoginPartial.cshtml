@using Microsoft.AspNetCore.Identity
@using AutoGestion.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-2 mb-2 mb-lg-0">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-light d-flex align-items-center gap-1" asp-area="Identity" asp-page="/Account/Manage/Index" title="Gestionar Perfil">
                <i class="bi bi-person-circle text-warning fs-5"></i>
                <span class="text-truncate" style="max-width: 150px;">@User.Identity?.Name</span>
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                <button type="submit" class="btn btn-outline-light btn-sm d-flex align-items-center gap-1 py-1 px-2">
                    <i class="bi bi-box-arrow-right"></i> Salir
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-light d-flex align-items-center gap-1" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus"></i> Registrarse
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-warning btn-sm fw-semibold text-dark px-3 ms-lg-2 d-flex align-items-center gap-1 py-1" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
            </a>
        </li>
    }
</ul>
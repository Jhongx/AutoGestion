@using Microsoft.AspNetCore.Identity
@using AutoGestion.Data

@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="es" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoGestión</title>

    <!-- Bootstrap CSS y Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AutoGestion.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light d-flex flex-column h-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <i class="bi bi-wrench-gap-fill text-warning"></i>
                    <span>AutoGestión</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <!-- Módulos solo visibles si el usuario HA INICIADO SESIÓN -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-1">
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded" asp-area="" asp-page="/Index">
                                    <i class="bi bi-house-door"></i> Inicio
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded" asp-area="" asp-page="/Clients/Index">
                                    <i class="bi bi-people"></i> Clientes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded" asp-area="" asp-page="/Vehicles/Index">
                                    <i class="bi bi-car-front"></i> Vehículos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded" asp-page="/InspectionAppointments/Calendar">
                                    <i class="bi bi-calendar-check"></i> Citas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded" asp-area="" asp-page="/ReceivingOrders/Index">
                                    <i class="bi bi-clipboard-check"></i> Recepción
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded" asp-area="" asp-page="/Inventories/Index">
                                    <i class="bi bi-box-seam"></i> Inventario
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- Espaciador para empujar las opciones de Login/Registro a la derecha si no está autenticado -->
                        <div class="me-auto"></div>
                    }

                    <!-- Componente de Autenticación Identity -->
                    <partial name="_LoginPartial" />

                    <!-- Indicador visual rápido (solo cuando hay sesión activa) -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="d-flex align-items-center gap-2 text-light small opacity-75 d-none d-lg-flex ms-3">
                            <i class="bi bi-circle-fill text-success fs-6"></i> Taller en línea
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido principal expandible -->
    <div class="container my-3 my-md-4 flex-shrink-0 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer Ultracompacto e Integrado -->
    <footer class="bg-white border-top text-muted py-2 py-sm-3 mt-auto flex-shrink-0">
        <div class="container d-flex flex-row align-items-center justify-content-between gap-2" style="font-size: 0.8rem;">
            <div class="text-truncate">
                &copy; 2026 <span class="fw-semibold text-dark">AutoGestión</span>
                <span class="d-none d-md-inline"> — Sistema de Administración de Taller</span>
            </div>
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <a asp-area="" asp-page="/Info/Privacy" class="text-decoration-none text-muted">Privacidad</a>
                <span class="badge bg-secondary opacity-75 d-none d-sm-inline-block">v1.0 (.NET 10)</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@page
@model AutoGestion.Pages.InventoryMovements.MovementsHistoryModel
@{
    ViewData["Title"] = "Historial de Movimientos";
}

<div class="container-fluid px-2 px-md-4 py-3">
    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Inicio</a></li>
                    <li class="breadcrumb-item"><a asp-page="/Inventories/Index" class="text-decoration-none">Inventario</a></li>
                    <li class="breadcrumb-item active">Historial</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1 h3">
                <i class="bi bi-clock-history text-primary me-2"></i>Historial de Movimientos
            </h2>
            <p class="text-muted small mb-0">Registro y auditoría de todas las entradas y salidas de repuestos.</p>
        </div>

        <!-- Botones de Acción Superior -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-page="/Inventories/Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver a Inventario
            </a>
            <a asp-page="./Movement" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Registrar Movimiento
            </a>
        </div>
    </div>

    <!-- Barra de Búsqueda y Filtros -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" asp-for="SearchTerm" class="form-control bg-light border-start-0" placeholder="Buscar por referencia o nombre de repuesto..." />
                    </div>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary fw-semibold shadow-sm flex-grow-1">Filtrar</button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a asp-page="./MovementHistory" class="btn btn-outline-secondary fw-semibold shadow-sm">Limpiar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (Model.Movements != null && Model.Movements.Any())
    {
        <!-- VISTA MÓVIL: Tarjetas (Visible solo en dispositivos móviles) -->
        <div class="d-block d-md-none">
            <div class="d-flex flex-column gap-3">
                @foreach (var item in Model.Movements)
                {
                    var isInbound = item.Type == AutoGestion.Utilities.Commons.AppConstants.MovementType.Inbound;
                    <div class="card border-0 shadow-sm rounded-3 p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                @if (isInbound)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-semibold small">
                                        <i class="bi bi-arrow-down-left me-1"></i> Entrada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-semibold small">
                                        <i class="bi bi-arrow-up-right me-1"></i> Salida
                                    </span>
                                }
                            </div>
                            <span class="fw-bold fs-5 @(isInbound ? "text-success" : "text-danger")">
                                @(isInbound ? "+" : "-")@item.Quantity
                            </span>
                        </div>

                        <h6 class="fw-bold text-dark mb-1">
                            @(item.Inventory?.Name ?? $"Artículo ID: {item.InventoryId}")
                        </h6>

                        <div class="text-muted small mb-2">
                            <i class="bi bi-card-text me-1"></i> Ref: @(string.IsNullOrEmpty(item.Reference) ? "Sin referencia" : item.Reference)
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top small text-muted">
                            <span><i class="bi bi-calendar3 me-1"></i> @item.MovementDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            <span class="font-monospace fw-semibold text-dark">₡@item.UnitPrice.ToString("N2")</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- VISTA ESCRITORIO: Tabla tradicional (Oculta en móviles, visible de tablet en adelante) -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden d-none d-md-block">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase small text-muted">
                            <tr>
                                <th class="py-3 ps-4">Fecha / Hora</th>
                                <th class="py-3">Tipo</th>
                                <th class="py-3">Artículo</th>
                                <th class="py-3 text-center">Cantidad</th>
                                <th class="py-3 text-end">Precio Unitario</th>
                                <th class="py-3 pe-4">Referencia</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Movements)
                            {
                                var isInbound = item.Type == AutoGestion.Utilities.Commons.AppConstants.MovementType.Inbound;
                                <tr>
                                    <td class="ps-4 small text-muted">
                                        <i class="bi bi-calendar3 me-1"></i> @item.MovementDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (isInbound)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-semibold">
                                                <i class="bi bi-arrow-down-left me-1"></i> Entrada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-semibold">
                                                <i class="bi bi-arrow-up-right me-1"></i> Salida
                                            </span>
                                        }
                                    </td>
                                    <td class="fw-semibold text-dark">
                                        @(item.Inventory?.Name ?? $"Artículo ID: {item.InventoryId}")
                                    </td>
                                    <td class="text-center fw-bold">
                                        <span class="@(isInbound ? "text-success" : "text-danger")">
                                            @(isInbound ? "+" : "-")@item.Quantity
                                        </span>
                                    </td>
                                    <td class="text-end text-muted font-monospace">
                                        ₡@item.UnitPrice.ToString("N2")
                                    </td>
                                    <td class="pe-4 text-muted small">
                                        @(string.IsNullOrEmpty(item.Reference) ? "Sin referencia" : item.Reference)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Estado Vacío -->
        <div class="card border-0 shadow-sm rounded-3 py-5 text-center">
            <div class="card-body">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                <p class="text-muted mb-0">No se encontraron movimientos registrados en el historial.</p>
            </div>
        </div>
    }
</div>
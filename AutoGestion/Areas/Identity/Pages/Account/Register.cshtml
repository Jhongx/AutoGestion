@page
@model RegisterModel
@{
    ViewData["Title"] = "Registro de Usuario";
}

<div class="row justify-content-center align-items-center py-2 py-md-4">
    <div class="col-12 col-md-8 col-lg-5">

        <!-- Tarjeta Principal de Registro -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <!-- Encabezado con estilo Hero Banner -->
            <div class="card-header bg-dark text-white p-4 position-relative border-0"
                 style="background: linear-gradient(135deg, rgba(13,110,253,0.2) 0%, rgba(33,37,41,1) 100%);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge bg-primary bg-opacity-20 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill fw-semibold small">
                        <i class="bi bi-person-plus-fill me-1"></i> Nuevo Usuario
                    </span>
                    <i class="bi bi-wrench-gap-fill text-warning fs-4"></i>
                </div>
                <h4 class="fw-bold mb-1">Crear Cuenta</h4>
                <p class="text-white-50 small mb-0">Registra un nuevo usuario para otorgar acceso al sistema.</p>
            </div>

            <!-- Cuerpo del Formulario -->
            <div class="card-body p-4 p-md-5 bg-white">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

                    <!-- Resumen de Validaciones de Error -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small mb-4" role="alert"></div>

                    <!-- Campo Correo Electrónico -->
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold text-dark small">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Input.Email" class="form-control bg-light border-start-0 ps-0"
                                   autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Campo Contraseña -->
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold text-dark small">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Input.Password" id="passwordInput" class="form-control bg-light border-start-0 border-end-0 ps-0 shadow-none"
                                   autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                            <span class="input-group-text bg-light border-start-0 text-muted cursor-pointer" id="togglePassword" style="cursor: pointer;">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Campo Confirmar Contraseña -->
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold text-dark small">Confirmar Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <input asp-for="Input.ConfirmPassword" id="confirmPasswordInput" class="form-control bg-light border-start-0 border-end-0 ps-0 shadow-none"
                                   autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                            <span class="input-group-text bg-light border-start-0 text-muted cursor-pointer" id="toggleConfirmPassword" style="cursor: pointer;">
                                <i class="bi bi-eye" id="toggleConfirmPasswordIcon"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Botón de Registro -->
                    <button id="registerSubmit" type="submit" class="btn btn-primary fw-semibold w-100 py-2 shadow-sm rounded-3 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-person-check fs-5"></i> Registrar Usuario
                    </button>
                </form>
            </div>

            <!-- Footer de la Tarjeta (Volver a Login) -->
            <div class="card-footer bg-light border-0 p-3 text-center">
                <span class="text-muted small">¿Ya posees una cuenta registrada?</span>
                <a asp-page="./Login" class="fw-bold text-primary text-decoration-none small ms-1">
                    Iniciar Sesión aquí <i class="bi bi-chevron-right small"></i>
                </a>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function setupPasswordToggle(inputId, buttonId, iconId) {
            const input = document.getElementById(inputId);
            const button = document.getElementById(buttonId);
            const icon = document.getElementById(iconId);

            button.addEventListener('click', function() {
                const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                input.setAttribute('type', type);

                // Cambia el icono entre ojo abierto y cerrado
                icon.classList.toggle('bi-eye');
                icon.classList.toggle('bi-eye-slash');
            });
        }

        setupPasswordToggle('passwordInput', 'togglePassword', 'togglePasswordIcon');
        setupPasswordToggle('confirmPasswordInput', 'toggleConfirmPassword', 'toggleConfirmPasswordIcon');
    </script>
}
@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Confirmación de Restablecimiento";
}

<div class="row justify-content-center align-items-center py-2 py-md-4">
    <div class="col-12 col-md-8 col-lg-5">

        <!-- Tarjeta Principal de Confirmación -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <!-- Encabezado Hero Banner -->
            <div class="card-header bg-dark text-white p-4 position-relative border-0"
                 style="background: linear-gradient(135deg, rgba(13,110,253,0.2) 0%, rgba(33,37,41,1) 100%);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25 px-3 py-1 rounded-pill fw-semibold small">
                        <i class="bi bi-check-circle-fill me-1"></i> Correo Enviado
                    </span>
                    <i class="bi bi-wrench-gap-fill text-warning fs-4"></i>
                </div>
                <h4 class="fw-bold mb-1">Solicitud Procesada</h4>
                <p class="text-white-50 small mb-0">Revisa la bandeja de entrada de tu correo electrónico.</p>
            </div>

            <!-- Cuerpo del Mensaje -->
            <div class="card-body p-4 p-md-5 bg-white text-center">
                <div class="mb-3">
                    <div class="bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center rounded-circle p-3 mb-2" style="width: 64px; height: 64px;">
                        <i class="bi bi-envelope-check-fill fs-2"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-dark mb-2">¡Instrucciones enviadas!</h5>
                <p class="text-muted small mb-0">
                    Si el correo ingresado coincide con una cuenta activa en el sistema, te hemos enviado un enlace para restablecer tu contraseña.
                </p>
            </div>

            <!-- Footer de la Tarjeta (Regresar al Login) -->
            <div class="card-footer bg-light border-0 p-3 text-center">
                <a asp-page="./Login" class="btn btn-outline-primary fw-semibold w-100 py-2 rounded-3">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Inicio de Sesión
                </a>
            </div>

        </div>

    </div>
</div>
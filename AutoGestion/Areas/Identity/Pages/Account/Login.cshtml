@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center align-items-center py-2 py-md-4">
    <div class="col-12 col-md-8 col-lg-5">

        <!-- Tarjeta Principal de Login -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <!-- Encabezado con estilo Hero Banner -->
            <div class="card-header bg-dark text-white p-4 position-relative border-0"
                 style="background: linear-gradient(135deg, rgba(13,110,253,0.2) 0%, rgba(33,37,41,1) 100%);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge bg-primary bg-opacity-20 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill fw-semibold small">
                        <i class="bi bi-shield-lock-fill me-1"></i> Acceso Seguro
                    </span>
                    <i class="bi bi-wrench-gap-fill text-warning fs-4"></i>
                </div>
                <h4 class="fw-bold mb-1">Bienvenido a AutoGestión</h4>
                <p class="text-white-50 small mb-0">Ingresa tus credenciales para acceder al sistema de taller.</p>
            </div>

            <!-- Cuerpo del Formulario -->
            <div class="card-body p-4 p-md-5 bg-white">
                <form id="account" method="post">

                    <!-- Resumen de Validaciones de Error -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small mb-4" role="alert"></div>

                    <!-- Campo Correo Electrónico -->
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold text-dark small">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Input.Email" class="form-control bg-light border-start-0 ps-0"
                                   autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Campo Contraseña con Toggle Integrado -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Input.Password" class="form-label fw-semibold text-dark small mb-0">Contraseña</label>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-primary text-decoration-none small">
                                ¿Olvidaste tu contraseña?
                            </a>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Input.Password" id="loginPasswordInput" class="form-control bg-light border-start-0 border-end-0 ps-0 shadow-none"
                                   autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                            <span class="input-group-text bg-light border-start-0 text-muted cursor-pointer" id="toggleLoginPassword" style="cursor: pointer;">
                                <i class="bi bi-eye" id="toggleLoginPasswordIcon"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Checkbox Recordarme -->
                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheck" />
                        <label class="form-check-label small text-muted" for="rememberMeCheck">
                            Recordar esta sesión
                        </label>
                    </div>

                    <!-- Botón de Ingreso -->
                    <button id="login-submit" type="submit" class="btn btn-primary fw-semibold w-100 py-2 shadow-sm rounded-3 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-in-right fs-5"></i> Iniciar Sesión
                    </button>
                </form>
            </div>

            <!-- Footer de la Tarjeta (Acceso a Registro) -->
            <div class="card-footer bg-light border-0 p-3 text-center">
                <span class="text-muted small">¿Aún no tienes una cuenta de usuario?</span>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-primary text-decoration-none small ms-1">
                    Registrarse aquí <i class="bi bi-chevron-right small"></i>
                </a>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const passwordInput = document.getElementById('loginPasswordInput');
        const toggleButton = document.getElementById('toggleLoginPassword');
        const toggleIcon = document.getElementById('toggleLoginPasswordIcon');

        toggleButton.addEventListener('click', function() {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);

            toggleIcon.classList.toggle('bi-eye');
            toggleIcon.classList.toggle('bi-eye-slash');
        });
    </script>
}
@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<div class="row justify-content-center align-items-center py-2 py-md-4">
    <div class="col-12 col-md-8 col-lg-5">

        <!-- Tarjeta Principal de Recuperación -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <!-- Encabezado Hero Banner -->
            <div class="card-header bg-dark text-white p-4 position-relative border-0"
                 style="background: linear-gradient(135deg, rgba(13,110,253,0.2) 0%, rgba(33,37,41,1) 100%);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge bg-primary bg-opacity-20 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill fw-semibold small">
                        <i class="bi bi-key-fill me-1"></i> Restablecer Acceso
                    </span>
                    <i class="bi bi-wrench-gap-fill text-warning fs-4"></i>
                </div>
                <h4 class="fw-bold mb-1">¿Olvidaste tu contraseña?</h4>
                <p class="text-white-50 small mb-0">Ingresa tu correo electrónico para recibir un enlace de restablecimiento.</p>
            </div>

            <!-- Cuerpo del Formulario -->
            <div class="card-body p-4 p-md-5 bg-white">
                <form method="post">

                    <!-- Resumen de Validaciones de Error -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small mb-4" role="alert"></div>

                    <!-- Campo Correo Electrónico -->
                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label fw-semibold text-dark small">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Input.Email" class="form-control bg-light border-start-0 ps-0 shadow-none"
                                   autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Botón de Envío -->
                    <button type="submit" class="btn btn-primary fw-semibold w-100 py-2 shadow-sm rounded-3 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-send-fill fs-6"></i> Enviar Enlace de Restablecimiento
                    </button>
                </form>
            </div>

            <!-- Footer de la Tarjeta (Regresar al Login) -->
            <div class="card-footer bg-light border-0 p-3 text-center">
                <a asp-page="./Login" class="fw-bold text-primary text-decoration-none small">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Inicio de Sesión
                </a>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña Restablecida";
}

<div class="row justify-content-center align-items-center py-2 py-md-4">
    <div class="col-12 col-md-8 col-lg-5">

        <!-- Tarjeta Principal de Confirmación -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <!-- Encabezado con estilo Hero Banner -->
            <div class="card-header bg-dark text-white p-4 position-relative border-0"
                 style="background: linear-gradient(135deg, rgba(13,110,253,0.2) 0%, rgba(33,37,41,1) 100%);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25 px-3 py-1 rounded-pill fw-semibold small">
                        <i class="bi bi-shield-check me-1"></i> Proceso Completado
                    </span>
                    <i class="bi bi-wrench-gap-fill text-warning fs-4"></i>
                </div>
                <h4 class="fw-bold mb-1">¡Contraseña Actualizada!</h4>
                <p class="text-white-50 small mb-0">Tu clave de acceso ha sido restablecida correctamente.</p>
            </div>

            <!-- Cuerpo del Mensaje -->
            <div class="card-body p-4 p-md-5 bg-white text-center">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-check-lg fs-1"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Cambio Exitoso</h5>
                <p class="text-muted small mb-4">
                    Ahora puedes ingresar al sistema utilizando tu dirección de correo electrónico y la nueva contraseña que acabas de definir.
                </p>

                <a asp-page="./Login" class="btn btn-primary fw-semibold px-4 py-2 shadow-sm rounded-3 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-in-right fs-5"></i> Iniciar Sesión Ahora
                </a>
            </div>

            <!-- Footer de la Tarjeta -->
            <div class="card-footer bg-light border-0 p-3 text-center">
                <span class="text-muted small">AutoGestión — Sistema de Administración de Taller</span>
            </div>

        </div>

    </div>
</div>